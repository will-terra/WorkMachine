# Opcional: copie para .env (fica fora do git). Chaves e contas também podem ser informadas na tela,
# em Ajustes → Chaves e contas; uma variável aqui vale mais que o que estiver lá.

# Pasta do seu computador onde o backup do banco (a cada hora) é gravado. Padrão: ./backups
#   Windows com WSL: /mnt/c/Users/SEU_USUARIO/Documents/WorkMachine/backups
#   macOS:           /Users/SEU_USUARIO/Documents/WorkMachine/backups
# WORKMACHINE_BACKUP_DIR=

# IA via OpenRouter (padrão: DeepSeek V4 Pro): https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3

# Gmail com senha de app (alertas do LinkedIn e respostas das empresas)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# GMAIL_MAILBOX=INBOX
# LINKEDIN_ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com

# Token da extensão do navegador (normalmente gerado em Ajustes)
# WORKMACHINE_API_TOKEN=

# Aumenta o limite da API do GitHub (backend-br, frontendbr) de 60 para 5000 chamadas por hora
# GITHUB_TOKEN=

# Desenvolvimento: faz o docker compose usar o ambiente com o código montado
# COMPOSE_FILE=docker-compose.dev.yml
