# Copie para .env (fica fora do git) e preencha.

# IA via OpenRouter (padrão: DeepSeek V4 Pro): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Opcional: outro modelo do OpenRouter, por exemplo GLM 5.3
# OPENROUTER_MODEL=z-ai/glm-5.3

# Gmail com senha de app, para importar os alertas de vagas do LinkedIn
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcionais: pasta e remetentes dos alertas (separados por vírgula)
# GMAIL_MAILBOX=INBOX
# LINKEDIN_ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com

# Token que a extensão do navegador manda no header Authorization. Gere com: bin/rails secret
WORKMACHINE_API_TOKEN=

# Opcional: aumenta o limite da API do GitHub (backend-br/vagas) de 60 para 5000 req/h
GITHUB_TOKEN=
