# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Secrets
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Logs, tempfiles and pids
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# SQLite databases and uploads
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/backups
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/coverage

# Planos, pesquisa e CVs ficam só na máquina local.
/docs/

# Credentials are not used: the secrets of each installation are generated in storage/ (config/local_secrets.rb).
/config/credentials.yml.enc

# Personal context for Claude Code, kept out of the public repository.
/CLAUDE.local.md
