# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Secrets
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Logs, tempfiles and pids
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# SQLite databases and uploads
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules
/coverage
