<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
  <%= link_to t(".see"), routine_path, class: "btn btn-sm" %>
  <%= link_to t(".new"), new_settings_routine_path, class: "btn btn-primary btn-sm" %>
<% end %>

<ul class="grid gap-4">
  <% @routines.each do |routine| %>
    <li id="<%= dom_id(routine) %>" class="card flex-row flex-wrap items-center justify-between gap-4">
      <div class="min-w-0">
        <h2 class="text-lg"><%= routine.name %></h2>
        <p class="text-sm text-muted">
          <%= t(".blocks", count: routine.slots.size) %> ·
          <%= t(".tasks", count: routine.slots.sum { it.items.size }) %> ·
          <%= routine.slots.map { RoutineSlot.human_enum(:period, it.period) }.uniq.to_sentence %>
        </p>
      </div>
      <div class="flex gap-2">
        <%= link_to t(".edit"), edit_settings_routine_path(routine), class: "btn btn-sm" %>
        <%= button_to t(".delete"), settings_routine_path(routine), method: :delete, class: "btn btn-ghost btn-sm",
                      form: { data: { turbo_confirm: t(".delete_confirm", name: routine.name) } } %>
      </div>
    </li>
  <% end %>
</ul>

<% if @routines.empty? %>
  <p class="text-muted"><%= t(".empty") %></p>
<% end %>

<div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line pt-5 text-sm">
  <%= button_to t(".restore"), restore_settings_routines_path, class: "btn btn-sm", form: { data: { turbo_confirm: t(".restore_confirm") } } %>
  <span class="text-muted"><%= t(".restore_note") %></span>
</div>
