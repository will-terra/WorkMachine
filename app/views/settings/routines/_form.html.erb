<%= form_with model: [ :settings, routine ], class: "grid max-w-4xl gap-6" do |form| %>
  <%= render "shared/errors", record: routine %>

  <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_120px]">
    <div>
      <%= form.label :name, "Nome", class: "label" %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>
    <div>
      <%= form.label :position, "Ordem na página", class: "label" %>
      <%= form.number_field :position, min: 0, step: 1, class: "input" %>
    </div>
  </div>
  <div>
    <%= form.label :description, "Descrição (opcional)", class: "label" %>
    <%= form.text_field :description, class: "input" %>
  </div>

  <div class="grid gap-4" data-controller="nested-fields" data-nested-fields-placeholder-value="NEW_SLOT" data-nested-fields-handle-value="slot">
    <h2>Blocos</h2>
    <p class="-mt-2 text-sm text-muted">
      Cada bloco tem um período: <strong>todo dia</strong> recomeça a cada dia, <strong>toda semana</strong> fica marcado até domingo
      e <strong>uma vez</strong> fica marcado de vez (bom para configurações). As tarefas aceitam as variáveis do perfil, como
      <span class="font-mono text-xs">{{termos}}</span>, <span class="font-mono text-xs">{{area}}</span> e <span class="font-mono text-xs">{{cargo}}</span>.
      O link é opcional: uma tela do app (<span class="font-mono text-xs">/radar</span>) ou um endereço <span class="font-mono text-xs">https://</span>.
    </p>
    <div class="grid gap-4" data-nested-fields-target="list">
      <%= form.fields_for :slots do |slot_form| %>
        <%= render "slot_fields", form: slot_form %>
      <% end %>
    </div>
    <template data-nested-fields-target="template">
      <%= form.fields_for :slots, RoutineSlot.new(period: "daily"), child_index: "NEW_SLOT" do |slot_form| %>
        <%= render "slot_fields", form: slot_form %>
      <% end %>
    </template>
    <button type="button" class="btn btn-sm justify-self-start" data-action="nested-fields#add">+ Bloco</button>
  </div>

  <div class="flex flex-wrap gap-2 border-t border-line pt-5">
    <%= form.submit "Salvar rotina", class: "btn btn-primary" %>
    <%= link_to "Cancelar", settings_routines_path, class: "btn btn-ghost" %>
  </div>
<% end %>
