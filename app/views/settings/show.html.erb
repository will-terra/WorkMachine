<%= page_header eyebrow: "WorkMachine", title: "Ajustes" %>

<section class="mb-6 grid gap-6 lg:grid-cols-2">
  <%= render "settings/keys", setting: @setting %>
  <%= render "settings/extension", setting: @setting %>
</section>

<section class="grid gap-6 lg:grid-cols-2" aria-label="Notificações">
  <%= form_with model: @setting, url: settings_path, method: :patch, class: "card grid content-start gap-4 p-5" do |form| %>
    <div>
      <h2 class="text-base">Notificação de vagas novas</h2>
      <p class="muted mt-1 text-sm">Quando o agregador ou os alertas do LinkedIn trazem vagas com nota igual ou maior que esta, o WorkMachine manda uma notificação na área de trabalho, mesmo com o app fechado.</p>
    </div>
    <%= render "shared/errors", record: @setting %>
    <div class="flex items-center gap-2">
      <%= form.check_box :notifications_enabled, class: "size-4 accent-accent" %>
      <%= form.label :notifications_enabled, "Notificar vagas novas", class: "text-sm" %>
    </div>
    <div>
      <%= form.label :notify_min_score, "Nota mínima (0 a 100)", class: "label" %>
      <%= form.number_field :notify_min_score, min: 0, max: 100, step: 1, required: true, class: "input w-32" %>
      <p class="muted mt-1 text-xs">Vale para as próximas buscas. Cada vaga é notificada uma vez só.</p>
    </div>
    <div class="border-t border-line pt-4">
      <h2 class="text-base">Descarte automático</h2>
      <p class="muted mt-1 text-sm">Vagas do agregador e dos alertas que você não pode pegar já chegam descartadas. As salvas pela extensão nunca são descartadas. Para revisar, filtre Vagas → Triagem → Descartada automaticamente.</p>
    </div>
    <div class="flex items-start gap-2">
      <%= form.check_box :auto_dismiss_restricted, class: "mt-0.5 size-4 accent-accent" %>
      <%= form.label :auto_dismiss_restricted, "Descartar as vagas só para EUA/Canadá, só para Europa ou para uma lista de países fora da América Latina", class: "text-sm" %>
    </div>
    <div>
      <%= form.label :auto_dismiss_below_score, "Descartar também com nota abaixo de (vazio = não descartar)", class: "label" %>
      <%= form.number_field :auto_dismiss_below_score, min: 1, max: 100, step: 1, class: "input w-32" %>
    </div>
    <div class="border-t border-line pt-4">
      <h2 class="text-base">Respostas das empresas</h2>
      <p class="muted mt-1 text-sm">A cada hora o WorkMachine procura no Gmail os e-mails das empresas em que você aplicou. Os que citam a empresa vão para o modelo de IA (OpenRouter) classificar; recusa, entrevista, teste e proposta movem o cartão no kanban.</p>
    </div>
    <div class="flex items-center gap-2">
      <%= form.check_box :track_replies, class: "size-4 accent-accent" %>
      <%= form.label :track_replies, "Ler as respostas das empresas no Gmail", class: "text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= form.check_box :notify_replies, class: "size-4 accent-accent" %>
      <%= form.label :notify_replies, "Notificar quando uma empresa responder", class: "text-sm" %>
    </div>
    <div class="flex items-center gap-2">
      <%= form.check_box :notify_follow_ups, class: "size-4 accent-accent" %>
      <%= form.label :notify_follow_ups, "Às 8h, notificar os follow-ups do dia (candidaturas sem resposta há 5+ dias)", class: "text-sm" %>
    </div>
    <fieldset class="border-t border-line pt-4">
      <legend class="text-base font-bold tracking-tight">Fontes automáticas</legend>
      <p class="muted mt-1 mb-3 text-sm">O agregador busca nelas a cada 3 horas, pelos termos do seu perfil. As de nicho só aparecem quando combinam com a sua área ou a sua stack.</p>
      <%= hidden_field_tag "setting[enabled_sources][]", "" %>
      <div class="grid gap-1.5 sm:grid-cols-2">
        <% ::Sources.all.each do |source| %>
          <% applicable = source.applicable?(@profile) %>
          <label class="flex items-start gap-2 text-sm <%= "muted" unless applicable %>">
            <%= check_box_tag "setting[enabled_sources][]", source.key, @setting.source_enabled?(source.key), id: "source_#{source.key}", disabled: !applicable, class: "mt-0.5 size-4 accent-accent" %>
            <span><%= JobPosting.human_enum(:source, source.key) %><% unless applicable %> <span class="text-xs">(não combina com o seu perfil)</span><% end %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <div><%= form.submit "Salvar", class: "btn btn-primary" %></div>
  <% end %>

  <div class="card grid content-start gap-4 p-5"
       data-controller="push"
       data-push-public-key-value="<%= @setting.vapid_keys![:public_key] %>"
       data-push-subscribe-url-value="<%= push_subscriptions_path %>"
       data-push-unsubscribe-url-value="<%= unsubscribe_push_subscriptions_path %>"
       data-push-test-url-value="<%= test_push_subscriptions_path %>">
    <div>
      <h2 class="text-base">Este navegador</h2>
      <p class="muted mt-1 text-sm">Ative uma vez em cada navegador (no app instalado do Chrome, ative abrindo esta página nele).</p>
    </div>
    <p class="text-sm font-semibold" data-push-target="status" role="status">Verificando…</p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary btn-sm" data-push-target="enable" data-action="push#enable" hidden>Ativar notificações</button>
      <button type="button" class="btn btn-sm" data-push-target="test" data-action="push#test" hidden>Enviar notificação de teste</button>
      <button type="button" class="btn btn-ghost btn-sm" data-push-target="disable" data-action="push#disable" hidden>Desativar neste navegador</button>
    </div>

    <% if @push_subscriptions.any? %>
      <div>
        <p class="label">Navegadores que recebem</p>
        <ul class="grid gap-1 text-sm">
          <% @push_subscriptions.each do |subscription| %>
            <li class="flex items-center justify-between gap-2">
              <span><%= subscription.browser_name %> · desde <%= l(subscription.created_at.to_date, format: "%d/%m") %><% if subscription.last_sent_at %> · última em <%= l(subscription.last_sent_at, format: "%d/%m %H:%M") %><% end %></span>
              <%= button_to "Remover", push_subscription_path(subscription), method: :delete, class: "btn btn-ghost btn-sm" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</section>

<section class="card mt-6 grid gap-3 p-5" aria-labelledby="backup_title">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="backup_title" class="text-base">Backup do banco</h2>
      <p class="muted mt-1 text-sm">
        A cada hora o WorkMachine copia o banco para
        <span class="font-mono text-xs"><%= ENV["WORKMACHINE_BACKUP_DIR"].present? ? windows_path(ENV["WORKMACHINE_BACKUP_DIR"]) : "a pasta backups/ do projeto" %></span>.
        Ficam todas as cópias das últimas <%= DatabaseBackup::KEEP_HOURS %> horas e uma por dia dos últimos <%= DatabaseBackup::KEEP_DAYS %> dias.
      </p>
    </div>
    <%= button_to "Fazer backup agora", backup_settings_path, class: "btn btn-sm" %>
  </div>
  <% if @setting.last_backup_error.present? %>
    <p class="text-sm font-semibold text-accent" role="alert">O último backup falhou: <%= @setting.last_backup_error %></p>
  <% end %>
  <p class="text-sm">
    <% if @backups.any? %>
      Último: <strong><%= l(@backups.first.mtime, format: "%d/%m/%Y %H:%M") %></strong>
      (<%= number_to_human_size(@backups.first.size) %>) · <%= pluralize(@backups.size, "cópia", plural: "cópias") %> guardadas
    <% else %>
      <span class="text-warn">Nenhum backup ainda.</span>
    <% end %>
  </p>
</section>
