<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= page_header eyebrow: t(".eyebrow", version: AppVersion.current), title: t(".title"), intro: t(".intro") %>

<% if AppVersion.update_available? %>
  <p class="card mb-7 flex-row flex-wrap items-center justify-between gap-3 bg-accent-soft text-sm" role="status">
    <span><%= t(".update_html", latest: AppVersion.latest, current: AppVersion.current) %></span>
    <%= external_link t(".changelog"), AppVersion::RELEASES_PAGE, class: "btn btn-sm" %>
  </p>
<% end %>

<%= render layout: "settings/row", locals: { id: "idioma", title: t(".language.title"), note: t(".language.note") } do %>
  <%= form_with model: @setting, url: settings_path, method: :patch, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
    <fieldset>
      <legend class="label"><%= t("settings.show.language.label") %></legend>
      <div class="seg">
        <% LocalePreference::CHOICES.each do |choice| %>
          <label class="seg-opt" lang="<%= choice unless choice == "auto" %>"><%= form.radio_button :locale, choice %><%= t("settings.show.language.choices.#{choice}") %></label>
        <% end %>
      </div>
    </fieldset>
    <noscript><%= form.submit t("settings.show.language.save"), class: "btn btn-sm mt-3" %></noscript>
  <% end %>
<% end %>

<%= render layout: "settings/row", locals: { id: "chaves", title: t(".keys.title"), note: t(".keys.note") } do %>
  <%= render "settings/keys", setting: @setting %>
<% end %>

<%= render layout: "settings/row", locals: { id: "extensao", title: t(".extension.title"), note: t(".extension.note") } do %>
  <%= render "settings/extension", setting: @setting %>
<% end %>

<%= form_with model: @setting, url: settings_path, method: :patch, id: "preferences", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
  <% if @setting.errors.any? %><div class="pb-5"><%= render "shared/errors", record: @setting %></div><% end %>

  <%= render layout: "settings/row", locals: { id: "notificacoes", title: t(".notifications.title"), note: t(".notifications.note") } do %>
    <div class="flex flex-col">
      <%= render "settings/switch", form:, field: :notifications_enabled, label: t("settings.show.notifications.new_postings"),
                                    note: t("settings.show.notifications.new_postings_note") %>
      <%= render "settings/switch", form:, field: :notify_replies, label: t("settings.show.notifications.replies"), note: t("settings.show.notifications.replies_note") %>
      <%= render "settings/switch", form:, field: :notify_follow_ups, label: t("settings.show.notifications.follow_ups"), note: t("settings.show.notifications.follow_ups_note") %>
    </div>
    <div class="w-[220px]">
      <%= form.label :notify_min_score, t("settings.show.notifications.min_score"), class: "label" %>
      <%= form.number_field :notify_min_score, min: 0, max: 100, step: 1, required: true, class: "input" %>
    </div>
  <% end %>

  <%= render layout: "settings/row", locals: { id: "descarte", title: t(".dismissal.title"), note: t(".dismissal.note") } do %>
    <div class="flex flex-col">
      <%= render "settings/switch", form:, field: :auto_dismiss_restricted, label: t("settings.show.dismissal.restricted"),
                                    note: t("settings.show.dismissal.restricted_note") %>
      <%= render "settings/switch", form:, field: :track_replies, label: t("settings.show.dismissal.track_replies"),
                                    note: t("settings.show.dismissal.track_replies_note") %>
    </div>
    <div class="w-[240px]">
      <%= form.label :auto_dismiss_below_score, t("settings.show.dismissal.below"), class: "label" %>
      <% options = ([ 10, 15, 20, 25, 30 ] | [ @setting.auto_dismiss_below_score ].compact).sort %>
      <%= form.select :auto_dismiss_below_score, options, { include_blank: t("settings.show.dismissal.never") }, class: "input" %>
    </div>
  <% end %>

  <%= render layout: "settings/row", locals: { id: "fontes", title: t(".sources.title"), note: t(".sources.note") } do %>
    <%= hidden_field_tag "setting[enabled_sources][]", "", id: nil %>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,210px),1fr))] gap-x-6 gap-y-1">
      <% ::Sources.all.each do |source| %>
        <% applicable = source.applicable?(@profile) %>
        <label class="flex cursor-pointer items-start gap-2.5 py-1 text-sm leading-[1.45] <%= "text-muted" unless applicable %>" title="<%= t("settings.show.sources.not_applicable") unless applicable %>">
          <%= check_box_tag "setting[enabled_sources][]", source.key, @setting.source_enabled?(source.key), id: "source_#{source.key}", disabled: !applicable, class: "check mt-[3px]" %>
          <span><%= JobPosting.human_enum(:source, source.key) %></span>
        </label>
      <% end %>
    </div>
  <% end %>
  <noscript><div class="pb-7"><%= form.submit t(".save"), class: "btn btn-primary" %></div></noscript>
<% end %>

<%= render layout: "settings/row", locals: { id: "navegadores", title: t(".browser.title"), note: t(".browser.note") } do %>
  <div class="flex flex-col gap-3"
       data-controller="push"
       data-push-public-key-value="<%= @setting.vapid_keys![:public_key] %>"
       data-push-subscribe-url-value="<%= push_subscriptions_path %>"
       data-push-unsubscribe-url-value="<%= unsubscribe_push_subscriptions_path %>"
       data-push-test-url-value="<%= test_push_subscriptions_path %>">
    <p class="text-[14.5px] font-medium" data-push-target="status" role="status"><%= t("settings.show.browser.checking") %></p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary" data-push-target="enable" data-action="push#enable" hidden><%= t("settings.show.browser.enable") %></button>
      <button type="button" class="btn btn-ghost" data-push-target="test" data-action="push#test" hidden><%= t("settings.show.browser.test") %></button>
      <button type="button" class="btn btn-ghost" data-push-target="disable" data-action="push#disable" hidden><%= t("settings.show.browser.disable") %></button>
    </div>
    <% if @push_subscriptions.any? %>
      <ul class="flex flex-col">
        <% @push_subscriptions.each do |subscription| %>
          <li class="flex items-center justify-between gap-2 border-t border-line py-1.5 text-sm">
            <span><%= subscription.browser_name %> · <%= t("settings.show.browser.since", date: l(subscription.created_at.to_date, format: :day_month)) %><span class="font-mono text-xs text-muted"><% if subscription.last_sent_at %> · <%= t("settings.show.browser.last", date: l(subscription.last_sent_at, format: :day_month_hour)) %><% end %></span></span>
            <%= button_to t("settings.show.browser.remove"), push_subscription_path(subscription), method: :delete, class: "btn btn-ghost btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<%= render layout: "settings/row", locals: { id: "rotinas", title: t(".routines.title"), note: t(".routines.note") } do %>
  <div><%= link_to t("settings.show.routines.edit"), settings_routines_path, class: "btn" %></div>
<% end %>

<%= render layout: "settings/row", locals: { id: "backup", title: t(".backup.title"), note: t(".backup.note", hours: DatabaseBackup::KEEP_HOURS, days: DatabaseBackup::KEEP_DAYS) } do %>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5">
    <span class="font-mono text-[13px]">
      <% if @backups.any? %>
        <%= t("settings.show.backup.last", time: short_time(@backups.first.mtime), size: number_to_human_size(@backups.first.size), count: @backups.size) %>
      <% else %>
        <span class="text-warn-strong"><%= t("settings.show.backup.none") %></span>
      <% end %>
      <span class="block text-muted"><%= ENV["WORKMACHINE_BACKUP_DIR"].present? ? windows_path(ENV["WORKMACHINE_BACKUP_DIR"]) : "backups/" %></span>
    </span>
    <%= button_to t("settings.show.backup.now"), backup_settings_path, class: "btn" %>
  </div>
  <% if @setting.last_backup_error.present? %>
    <p class="text-sm font-semibold text-warn-strong" role="alert"><%= t("settings.show.backup.failed", error: @setting.last_backup_error) %></p>
  <% end %>
<% end %>
