<%# Locals: form, field, label, type (:password, :email…), placeholder %>
<% saved = AppKeys.saved(field).present? %>
<%= form.label field, label, class: "label" %>
<% if AppKeys.from_env?(field) %>
  <p class="flex min-h-9 items-center text-sm"><span class="chip chip-ok"><%= t(".from_env") %></span></p>
<% else %>
  <% value = type == :password ? nil : AppKeys.saved(field) %>
  <%= form.public_send(type == :password ? :password_field : :email_field, field, value:, autocomplete: "off",
                       class: [ "input", ("font-mono" if type == :password) ],
                       placeholder: saved && type == :password ? t(".saved_placeholder") : placeholder) %>
  <% if saved %>
    <label class="mt-1.5 flex items-center gap-1.5 text-xs text-muted">
      <%= check_box_tag "clear[]", field, false, id: "clear_#{field}", class: "check" %> <%= t(".clear") %>
    </label>
  <% end %>
<% end %>
