<li id="<%= dom_id(job_application) %>" class="card cursor-grab p-3 text-sm shadow-xs active:cursor-grabbing"
    data-move-url="<%= move_job_application_path(job_application) %>">
  <p class="font-semibold leading-tight"><%= job_application.company %></p>
  <p class="muted leading-snug"><%= job_application.role %></p>

  <div class="mt-2 flex flex-wrap gap-1">
    <% if job_application.origin.present? %>
      <span class="chip"><%= job_application.origin %></span>
    <% end %>
    <% if job_application.applied_on %>
      <span class="chip" title="Aplicou em">↗ <%= short_date(job_application.applied_on) %></span>
    <% end %>
    <% if job_application.next_follow_up_on %>
      <span class="chip <%= job_application.next_follow_up_on <= Date.current ? "chip-warn" : "" %>" title="Próximo follow-up">
        follow-up <%= short_date(job_application.next_follow_up_on) %>
      </span>
    <% end %>
  </div>

  <div class="mt-2 flex gap-3 text-xs">
    <%= link_to "Editar", edit_job_application_path(job_application) %>
    <%= external_link "Abrir vaga", job_application.url if job_application.url.present? %>
  </div>
</li>
