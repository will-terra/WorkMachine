<%# Interview preparation: the date (from the e-mail or the form, with a reminder the day before)
    and the AI sheet made from the job, the profile and the company's e-mails. %>
<% preps = job_application.ai_artifacts.interview_prep.latest_first %>
<section id="entrevista" class="mt-12 max-w-[72ch] scroll-mt-20" aria-labelledby="interview_title">
  <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1">
    <h2 id="interview_title"><%= t(".title") %></h2>
    <% if Ai::Client.configured? %><span class="font-mono text-xs text-muted"><%= Ai::Client.model %><%= " · #{t("job_postings.ai.free")}" if Ai::Client.free? %></span><% end %>
  </div>
  <p class="mt-1 text-[13.5px] text-muted"><%= t(".note") %></p>

  <p class="mt-3 text-sm">
    <% if job_application.interview_at&.future? %>
      <%= t(".scheduled", date: l(job_application.interview_at, format: :full)) %>
    <% else %>
      <span class="text-muted"><%= t(".no_date") %></span>
    <% end %>
  </p>

  <% if Ai::Client.configured? %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to (preps.any? ? t(".prepare_again") : t(".prepare")), job_application_ai_artifacts_path(job_application, kind: "interview_prep"), class: "btn btn-primary" %>
      <%= turbo_frame_tag "ai_estimate", src: estimate_job_application_ai_artifacts_path(job_application), loading: "lazy" %>
    </div>
  <% else %>
    <p class="mt-4 text-sm"><%= t("job_postings.ai.no_key_html", link: link_to(t("job_postings.ai.no_key_link"), settings_path(anchor: "chaves"))) %></p>
  <% end %>

  <% if preps.any? %>
    <div class="mt-5 flex flex-col gap-3"><%= render partial: "ai_artifacts/ai_artifact", collection: preps %></div>
  <% end %>
</section>
