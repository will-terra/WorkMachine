<%= form_with model: message_template, class: "card grid gap-4 p-5 sm:grid-cols-3" do |form| %>
  <div class="sm:col-span-3"><%= render "shared/errors", record: message_template %></div>
  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>
  <div>
    <%= form.label :language, class: "label" %>
    <%= form.select :language, MessageTemplate.enum_options(:language), {}, class: "input" %>
  </div>
  <div>
    <%= form.label :max_chars, class: "label" %>
    <%= form.number_field :max_chars, min: 1, placeholder: t(".max_placeholder"), class: "input" %>
  </div>
  <div class="sm:col-span-3">
    <%= form.label :body, class: "label" %>
    <%= form.text_area :body, rows: 6, required: true, class: "input" %>
    <p class="muted mt-1 text-xs"><%= t(".help") %></p>
  </div>
  <div class="flex gap-2 sm:col-span-3">
    <%= form.submit t(".save"), class: "btn btn-primary" %>
    <%= link_to t(".cancel"), message_templates_path, class: "btn btn-ghost" %>
  </div>
<% end %>
