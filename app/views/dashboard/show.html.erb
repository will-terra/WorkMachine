<% content_for :title, "Painel" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<% unless Setting.current.onboarded? %>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-6" role="status">
    <span class="chip chip-warn">Primeiro uso</span>
    <span>Falta pouco para o WorkMachine buscar vagas para você: chave da IA, perfil e primeira busca.</span>
    <%= link_to "Continuar a configuração", onboarding_path, class: "btn btn-primary" %>
  </div>
<% end %>

<section class="pt-8" aria-labelledby="routine_title">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2.5">
    <h1 id="routine_title" class="text-2xl tracking-[-0.02em]">Rotina de hoje</h1>
    <div class="flex items-center gap-[18px] text-[13px]">
      <%= render "routines/progress", checked: @checked, track: "h-1 w-24" %>
      <%= link_to "Ver regras", routine_path(anchor: "regras") %>
    </div>
  </div>
  <%= render "routines/checklist", checked: @checked %>
</section>

<section class="mt-8 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2.5 border-y border-line py-3" aria-label="Candidaturas por status">
  <div class="flex flex-wrap gap-x-[22px] gap-y-1 text-sm">
    <% JobApplication::OPEN_STATUSES.each do |status| %>
      <% count = @pipeline.fetch(status, 0) %>
      <%= link_to job_applications_path(view: "table", status:), class: "flex items-baseline gap-1.5 text-ink no-underline hover:text-accent-hover" do %>
        <%= JobApplication.human_enum(:status, status) %>
        <span class="font-mono text-[13px] font-semibold <%= count.positive? ? "text-accent-bright" : "text-muted" %>"><%= count %></span>
      <% end %>
    <% end %>
  </div>
  <p class="flex flex-wrap gap-x-[18px] gap-y-1 font-mono text-[11.5px] text-muted">
    <span><%= pluralize(@pipeline.slice(*JobApplication::OPEN_STATUSES).values.sum, "candidatura em andamento", plural: "candidaturas em andamento") %></span>
    <span><%= fetch_line(@last_fetch_at) %></span>
    <% if @last_gmail_at %><span>Gmail <%= clock(@last_gmail_at) %></span><% end %>
  </p>
</section>

<div class="flex flex-wrap gap-x-[clamp(36px,5vw,80px)] gap-y-10 pt-8">
  <section class="min-w-0 flex-[7_1_480px]" aria-labelledby="new_postings_title">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="new_postings_title">Vagas novas por nota</h2>
      <% if @new_postings_count.positive? %>
        <%= link_to "#{@new_postings_count} para triar →", job_postings_path, class: "text-[13.5px]" %>
      <% end %>
    </div>

    <% if (lead = @new_postings.first) %>
      <article class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-x-[22px] gap-y-1.5 pt-[18px] pb-3.5">
        <span class="font-display text-6xl leading-[0.9] font-bold tracking-[-0.04em] text-accent" title="Nota de 0 a 100"><%= lead.score %></span>
        <div class="min-w-0">
          <p class="font-mono text-[11.5px] text-muted">melhor nota · via <%= lead.human_enum(:source) %> · <%= posted_ago(lead.posted_or_found_at) %></p>
          <h3 class="mt-1.5 text-[21px] leading-tight"><%= link_to lead.title, job_postings_path(selected: lead.id), class: "text-ink no-underline hover:underline" %></h3>
          <p class="mt-1 text-sm text-muted"><%= [ lead.display_company, lead.human_enum(:remote_scope), (lead.human_enum(:seniority) unless lead.seniority_unknown?), lead.salary_text.presence ].compact.join(" · ") %></p>
          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            <%= button_to "Salvar", save_job_posting_path(lead, from: "painel"), class: "btn btn-primary", title: "Salvar em Candidaturas" %>
            <%= button_to "Descartar", dismiss_job_posting_path(lead, from: "painel"), class: "btn" %>
            <%= link_to "Ler a vaga", job_postings_path(selected: lead.id), class: "btn btn-ghost" %>
            <span class="ml-1.5 flex flex-wrap gap-1"><%= posting_terms(lead) %></span>
          </div>
        </div>
      </article>
      <div class="flex flex-col">
        <% @new_postings.drop(1).each do |posting| %>
          <%= link_to job_postings_path(selected: posting.id), class: "group grid grid-cols-[44px_minmax(0,1fr)] items-baseline gap-3.5 py-[7px] text-ink no-underline hover:text-ink" do %>
            <span class="font-mono text-[17px] leading-none font-semibold <%= score_class(posting.score) %>"><%= posting.score %></span>
            <span class="min-w-0">
              <span class="block text-[15px] leading-[1.3] font-medium group-hover:underline"><%= posting.title %></span>
              <span class="mt-0.5 block text-[13px] text-muted"><%= posting_meta(posting) %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="py-5 text-muted">Nenhuma vaga nova. O agregador roda a cada 3 horas.</p>
    <% end %>
  </section>

  <aside class="flex min-w-0 flex-[5_1_340px] flex-col gap-9">
    <section aria-labelledby="follow_ups_title">
      <h2 id="follow_ups_title">Follow-ups do dia</h2>
      <div class="mt-3.5 flex flex-col gap-3.5">
        <% @follow_ups.each do |application| %>
          <div class="flex items-center justify-between gap-4">
            <div class="min-w-0">
              <p class="text-[15px] leading-[1.3] font-semibold"><%= application.company %></p>
              <p class="mt-0.5 text-[13px] leading-[1.4] text-muted"><%= application.role %> · <%= follow_up_when(application) %></p>
            </div>
            <div class="flex flex-none gap-1">
              <%= link_to "Follow-up", MessageTemplate.follow_up_path(application), class: "btn btn-sm" %>
              <%= link_to "Editar", edit_job_application_path(application), class: "btn btn-ghost btn-sm" %>
            </div>
          </div>
        <% end %>
        <% if @follow_ups.empty? %>
          <p class="text-sm text-muted">Nada para cobrar hoje.</p>
        <% end %>
      </div>
    </section>

    <% if @replies.any? %>
      <section aria-labelledby="replies_title">
        <h2 id="replies_title">Respostas das empresas</h2>
        <ul class="mt-3.5 flex flex-col gap-4">
          <%= render partial: "application_emails/application_email", collection: @replies, locals: { show_company: true } %>
        </ul>
      </section>
    <% end %>
  </aside>
</div>
