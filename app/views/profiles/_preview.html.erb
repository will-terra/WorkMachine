<%# Prévia das notas (side column): the latest postings now and with the form as it is, without saving. %>
<%= turbo_frame_tag "profile_preview" do %>
  <% if preview.profile.invalid? %>
    <div class="mt-3"><%= render "shared/errors", record: preview.profile %></div>
  <% end %>
  <p class="mt-1 text-[13.5px] text-muted">
    <% if preview.scores.empty? %>
      <%= t(".no_postings") %>
    <% elsif preview.changed_scores.zero? %>
      <%= t(".no_change", count: preview.scores.size) %>
    <% else %>
      <%= t(".changed", count: preview.changed_scores) %>
    <% end %>
  </p>

  <% if preview.scores.any? %>
    <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto_auto] gap-x-3.5 font-mono text-xs text-muted">
      <span><%= t(".job") %></span><span class="text-right"><%= t(".now") %></span><span class="min-w-[52px] text-right"><%= t(".preview") %></span>
    </div>
    <div class="flex flex-col">
      <% preview.scores.each do |score| %>
        <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-baseline gap-x-3.5 border-t border-line py-2">
          <span class="min-w-0">
            <span class="block text-sm leading-[1.3] font-medium"><%= score.posting.title %></span>
            <span class="block text-[12.5px] text-muted"><%= score.posting.display_company %></span>
          </span>
          <span class="text-right font-mono text-[13px] text-muted"><%= score.before %></span>
          <span class="min-w-[52px] text-right font-mono text-sm font-semibold <%= score_class(score.after) %>">
            <%= score.after %>
            <span class="block text-[11px] font-normal <%= score.change.positive? ? "text-accent-bright" : "text-warn-strong" %>"><%= points(score.change) if score.change.nonzero? %></span>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>

  <p class="mt-4 text-[13px] text-muted">
    <%= t(".search_html", terms: tag.strong(preview.profile.effective_search_terms.first(3).join(", ").presence || t(".nothing"), class: "text-ink"), count: preview.sources.size) %>
  </p>
  <% if preview.changed_searches.any? %>
    <details class="mt-3">
      <summary class="text-[13.5px] text-accent hover:text-accent-hover"><%= t(".changed_searches", count: preview.changed_searches.size) %></summary>
      <ul class="mt-2 grid gap-2">
        <% preview.changed_searches.each do |search| %>
          <li class="text-[13px]"><span class="font-semibold"><%= search["title"] %></span><span class="code mt-1 block" translate="no"><%= search["query"] %></span></li>
        <% end %>
      </ul>
    </details>
  <% end %>
<% end %>
