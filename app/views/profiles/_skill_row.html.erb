<tr data-profile-form-target="skill">
  <td class="min-w-40">
    <%= text_field_tag "profile[skills][#{index}][name]", skill["name"], class: "input", aria: { label: "Skill" }, placeholder: "Ex.: Python" %>
  </td>
  <td>
    <%= select_tag "profile[skills][#{index}][level]", options_for_select(Profile::LEVELS.keys.map { [ Profile.human_enum(:levels, it), it ] }, skill["level"] || "important"),
                   class: "input", aria: { label: "Nível" } %>
  </td>
  <td class="min-w-48">
    <%= text_field_tag "profile[skills][#{index}][synonyms]", Array(skill["synonyms"]).join(", "), class: "input", aria: { label: "Sinônimos" }, placeholder: "separados por vírgula" %>
  </td>
  <td class="text-right">
    <%= hidden_field_tag "profile[skills][#{index}][_destroy]", "0", data: { profile_form_target: "destroy" } %>
    <button type="button" class="btn btn-ghost btn-sm" data-action="profile-form#removeSkill" aria-label="Remover <%= skill["name"].presence || "skill" %>">Remover</button>
  </td>
</tr>
