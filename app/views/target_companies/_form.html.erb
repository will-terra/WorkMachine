<%= form_with model: target_company, class: "card grid gap-4 p-5 sm:grid-cols-2" do |form| %>
  <div class="sm:col-span-2"><%= render "shared/errors", record: target_company %></div>
  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>
  <div>
    <%= form.label :ats, class: "label" %>
    <%= form.select :ats, TargetCompany.enum_options(:ats), {}, class: "input" %>
  </div>
  <div>
    <%= form.label :board_slug, class: "label" %>
    <%= form.text_field :board_slug, required: true, placeholder: "gitlab", class: "input font-mono" %>
  </div>
  <div class="flex items-end gap-2 pb-2">
    <%= form.check_box :active, class: "size-4 accent-accent" %>
    <%= form.label :active, "Consultar no agregador", class: "text-sm" %>
  </div>
  <div class="flex gap-2 sm:col-span-2">
    <%= form.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", target_companies_path, class: "btn btn-ghost" %>
  </div>
<% end %>
