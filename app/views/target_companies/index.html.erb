<%= page_header eyebrow: "quadros de vagas", title: "Empresas-alvo",
                intro: "Empresas com quadro público no Greenhouse, Lever, Ashby ou Workable. O agregador lê esses quadros a cada 3 horas e guarda só os cargos da sua área." do %>
  <%= form_with url: find_target_companies_path, class: "flex flex-wrap items-end gap-2.5" do |form| %>
    <div class="w-[240px]">
      <%= form.label :name, "Procurar o quadro de uma empresa", class: "label" %>
      <%= form.text_field :name, placeholder: "nome da empresa", class: "input", title: "Vazio: procura de novo as empresas das suas candidaturas" %>
    </div>
    <%= form.submit "Procurar", class: "btn", data: { disable_with: "Procurando…" } %>
  <% end %>
  <%= link_to "Adicionar", new_target_company_path, class: "btn btn-primary" %>
<% end %>

<% if @suggestions.any? %>
  <section class="pb-9" aria-labelledby="suggestions_title">
    <h2 id="suggestions_title">Sugeridas</h2>
    <p class="mt-1 text-[13.5px] text-muted">Uma vaga salva apontava para o quadro destas empresas, ou você procurou por elas.</p>
    <div class="mt-3.5 grid grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-3">
      <% @suggestions.each do |company| %>
        <div id="<%= dom_id(company) %>" class="card gap-1">
          <p class="font-display text-[17px] font-semibold"><%= company.name %></p>
          <p class="font-mono text-xs text-muted"><%= external_link "#{company.ats} · #{company.board_slug}", company.board_url, class: "text-muted no-underline hover:text-accent-hover" %></p>
          <p class="mt-1 text-[13px] leading-[1.4] text-muted">
            <% if company.discovered_from %>
              via “<%= link_to company.discovered_from.title.truncate(60), job_posting_path(company.discovered_from), class: "text-muted" %>”
            <% else %>
              procurada por você
            <% end %>
          </p>
          <div class="mt-2 flex gap-1.5">
            <%= button_to "Ativar", activate_target_company_path(company), class: "btn btn-primary btn-sm" %>
            <%= button_to "Dispensar", dismiss_target_company_path(company), class: "btn btn-ghost btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<div class="flex flex-wrap items-baseline justify-between gap-3 pb-2">
  <h2>Quadros consultados</h2>
  <span class="font-mono text-xs text-muted">
    <%= @target_companies.count(&:active?) %> ativos · <%= @target_companies.count { !it.active? } %> pausados
  </span>
</div>
<div class="overflow-x-auto">
  <table class="table min-w-[780px]">
    <thead>
      <tr>
        <th>Empresa</th><th>Quadro</th><th class="text-right">Vagas</th><th class="text-right">Salvas</th>
        <th class="text-right">Auto-descartadas</th><th>Última leitura</th><th>Ativa</th><th><span class="sr-only">Ações</span></th>
      </tr>
    </thead>
    <tbody>
      <% @target_companies.each do |company| %>
        <% stats = @stats.fetch([ company.ats, company.board_slug ], { total: 0, saved: 0, auto_dismissed: 0 }) %>
        <tr id="<%= dom_id(company) %>" class="<%= "opacity-55" unless company.active? %>">
          <td>
            <span class="flex items-center gap-2 font-semibold">
              <%= company.name %>
              <% if company.example? %><span class="chip">exemplo</span><% end %>
            </span>
          </td>
          <td><%= external_link "#{company.ats}/#{company.board_slug}", company.board_url, class: "font-mono text-[12.5px]" %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:total] %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:saved] %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:auto_dismissed] %></td>
          <td class="font-mono text-[12.5px] whitespace-nowrap"><%= short_time(company.last_fetched_at) %></td>
          <td>
            <%= form_with model: company, class: "flex", data: { controller: "auto-submit" } do |form| %>
              <%= form.check_box :active, class: "switch", role: "switch", aria: { label: "#{company.name} ativa" }, data: { action: "auto-submit#submit" } %>
              <noscript><%= form.submit "Salvar", class: "btn btn-sm ml-2" %></noscript>
            <% end %>
          </td>
          <td class="text-right"><%= link_to "Editar", edit_target_company_path(company), class: "btn btn-ghost btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="mt-3 max-w-[72ch] text-[13px] text-muted">Para achar o slug, abra a página de vagas da empresa: em <span class="font-mono">job-boards.greenhouse.io/<b>gitlab</b></span>, <span class="font-mono">jobs.lever.co/<b>empresa</b></span>, <span class="font-mono">jobs.ashbyhq.com/<b>empresa</b></span> ou <span class="font-mono">apply.workable.com/<b>empresa</b></span>, o slug é a parte em negrito.</p>
