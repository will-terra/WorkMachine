<%= page_header eyebrow: "Agregador", title: "Empresas-alvo",
                intro: "Empresas com quadro público no Greenhouse, Lever, Ashby ou Workable. O agregador consulta cada empresa ativa a cada 3 horas e guarda só as vagas de engenharia. Quando uma vaga nova aponta para um desses quadros, a empresa entra aqui sozinha: ativa se a vaga tiver nota boa, ou como sugestão." do %>
  <%= button_to "Buscar nas candidaturas", find_target_companies_path, class: "btn btn-sm" %>
  <%= link_to "Adicionar empresa", new_target_company_path, class: "btn btn-primary btn-sm" %>
<% end %>

<% if @suggestions.any? %>
  <section class="mb-8" aria-labelledby="suggestions_title">
    <h2 id="suggestions_title" class="mb-2 text-base">Sugestões encontradas nas vagas</h2>
    <div class="card divide-y divide-line">
      <% @suggestions.each do |company| %>
        <div id="<%= dom_id(company) %>" class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="min-w-0">
            <p class="font-semibold"><%= company.name %> <span class="chip ml-1"><%= company.human_enum(:ats) %></span></p>
            <p class="muted text-sm">
              <%= external_link company.board_url, company.board_url, class: "font-mono text-xs" %>
              <% if company.discovered_from %> · vista em <%= link_to company.discovered_from.title.truncate(60), job_posting_path(company.discovered_from) %><% end %>
            </p>
          </div>
          <div class="flex gap-1.5">
            <%= button_to "Ativar", activate_target_company_path(company), class: "btn btn-primary btn-sm" %>
            <%= button_to "Ignorar", dismiss_target_company_path(company), class: "btn btn-ghost btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<div class="card overflow-x-auto">
  <table class="table">
    <thead><tr><th>Empresa</th><th>Sistema</th><th>Quadro</th><th>Ativa</th><th title="Vagas trazidas pelo quadro · salvas · descartadas automaticamente">Vagas</th><th>Última busca</th><th><span class="sr-only">Ações</span></th></tr></thead>
    <tbody>
      <% @target_companies.each do |company| %>
        <tr id="<%= dom_id(company) %>">
          <td class="font-semibold">
            <%= company.name %>
            <% if company.example? %> <span class="chip ml-1">exemplo</span><% end %>
            <% if company.discovered_at %> <span class="chip chip-ok ml-1" title="Encontrada numa vaga">descoberta</span><% end %>
          </td>
          <td><%= company.human_enum(:ats) %></td>
          <td><%= external_link company.board_slug, company.board_url, class: "font-mono text-xs" %></td>
          <td><%= company.active? ? "Sim" : "Não" %></td>
          <td class="whitespace-nowrap text-xs">
            <% if (stats = @stats[[ company.ats, company.board_slug ]]) %>
              <%= stats[:total] %> · <span class="<%= stats[:saved].positive? ? "text-ok font-semibold" : "muted" %>"><%= stats[:saved] %> salvas</span>
              <% if stats[:auto_dismissed].positive? %> · <span class="muted"><%= stats[:auto_dismissed] %> descartadas auto.</span><% end %>
            <% else %>
              <span class="muted">—</span>
            <% end %>
          </td>
          <td class="whitespace-nowrap"><%= company.last_fetched_at ? l(company.last_fetched_at, format: "%d/%m %H:%M") : "—" %></td>
          <td class="text-right"><%= link_to "Editar", edit_target_company_path(company) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="muted mt-3 max-w-prose text-sm">Para achar o slug, abra a página de vagas da empresa: em <span class="font-mono">job-boards.greenhouse.io/<b>gitlab</b></span>, <span class="font-mono">jobs.lever.co/<b>empresa</b></span>, <span class="font-mono">jobs.ashbyhq.com/<b>empresa</b></span> ou <span class="font-mono">apply.workable.com/<b>empresa</b></span>, o slug é a parte em negrito.</p>
