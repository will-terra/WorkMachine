<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
  <%= form_with url: find_target_companies_path, class: "flex flex-wrap items-end gap-2.5" do |form| %>
    <div class="w-[240px]">
      <%= form.label :name, t(".find_label"), class: "label" %>
      <%= form.text_field :name, placeholder: t(".find_placeholder"), class: "input", title: t(".find_title") %>
    </div>
    <%= form.submit t(".find"), class: "btn", data: { disable_with: t(".finding") } %>
  <% end %>
  <%= link_to t(".add"), new_target_company_path, class: "btn btn-primary" %>
<% end %>

<% if @suggestions.any? %>
  <section class="pb-9" aria-labelledby="suggestions_title">
    <h2 id="suggestions_title"><%= t(".suggested") %></h2>
    <p class="mt-1 text-[13.5px] text-muted"><%= t(".suggested_note") %></p>
    <div class="mt-3.5 grid grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-3">
      <% @suggestions.each do |company| %>
        <div id="<%= dom_id(company) %>" class="card gap-1">
          <p class="font-display text-[17px] font-semibold"><%= company.name %></p>
          <p class="font-mono text-xs text-muted"><%= external_link "#{company.ats} · #{company.board_slug}", company.board_url, class: "text-muted no-underline hover:text-accent-hover" %></p>
          <p class="mt-1 text-[13px] leading-[1.4] text-muted">
            <% if company.discovered_from %>
              <%= t(".via_html", link: link_to(company.discovered_from.title.truncate(60), job_posting_path(company.discovered_from), class: "text-muted")) %>
            <% else %>
              <%= t(".searched") %>
            <% end %>
          </p>
          <div class="mt-2 flex gap-1.5">
            <%= button_to t(".activate"), activate_target_company_path(company), class: "btn btn-primary btn-sm" %>
            <%= button_to t(".dismiss"), dismiss_target_company_path(company), class: "btn btn-ghost btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<div class="flex flex-wrap items-baseline justify-between gap-3 pb-2">
  <h2><%= t(".boards") %></h2>
  <span class="font-mono text-xs text-muted"><%= t(".boards_count", active: @target_companies.count(&:active?), paused: @target_companies.count { !it.active? }) %></span>
</div>
<div class="overflow-x-auto">
  <table class="table min-w-[780px]">
    <thead>
      <tr>
        <th><%= t(".company") %></th><th><%= t(".board") %></th><th class="text-right"><%= t(".postings") %></th><th class="text-right"><%= t(".saved") %></th>
        <th class="text-right"><%= t(".auto_dismissed") %></th><th><%= t(".last_read") %></th><th><%= t(".active") %></th><th><span class="sr-only"><%= t(".actions") %></span></th>
      </tr>
    </thead>
    <tbody>
      <% @target_companies.each do |company| %>
        <% stats = @stats.fetch([ company.ats, company.board_slug ], { total: 0, saved: 0, auto_dismissed: 0 }) %>
        <tr id="<%= dom_id(company) %>" class="<%= "opacity-55" unless company.active? %>">
          <td>
            <span class="flex items-center gap-2 font-semibold">
              <%= company.name %>
              <% if company.example? %><span class="chip"><%= t(".example") %></span><% end %>
            </span>
          </td>
          <td><%= external_link "#{company.ats}/#{company.board_slug}", company.board_url, class: "font-mono text-[12.5px]" %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:total] %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:saved] %></td>
          <td class="text-right font-mono text-[12.5px]"><%= stats[:auto_dismissed] %></td>
          <td class="font-mono text-[12.5px] whitespace-nowrap"><%= short_time(company.last_fetched_at) %></td>
          <td>
            <%= form_with model: company, class: "flex", data: { controller: "auto-submit" } do |form| %>
              <%= form.check_box :active, class: "switch", role: "switch", aria: { label: t(".active_label", name: company.name) }, data: { action: "auto-submit#submit" } %>
              <noscript><%= form.submit t(".save"), class: "btn btn-sm ml-2" %></noscript>
            <% end %>
          </td>
          <td class="text-right"><%= link_to t(".edit"), edit_target_company_path(company), class: "btn btn-ghost btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<p class="mt-3 max-w-[72ch] text-[13px] text-muted"><%= t(".slug_help_html") %></p>
