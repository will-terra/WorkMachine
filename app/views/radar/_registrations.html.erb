<% all = registrations.values.flatten %>
<p class="mt-2 font-mono text-xs text-muted" id="registrations_total"><%= render "radar/registrations_total", all: %></p>
<div class="mt-4 flex flex-wrap gap-x-12 gap-y-6">
  <% Consultancy.kinds.each_key do |kind| %>
    <% next if registrations[kind].blank? %>
    <div class="min-w-0 flex-[1_1_260px]">
      <h3 class="mb-1.5">
        <%= Consultancy.human_enum(:kind, kind) %>
        <span id="registrations_count_<%= kind %>" class="font-mono text-[11.5px] font-normal text-muted"><%= registrations[kind].count(&:registered?) %>/<%= registrations[kind].size %></span>
      </h3>
      <%= render partial: "consultancies/consultancy", collection: registrations[kind] %>
    </div>
  <% end %>
</div>
<details class="mt-5">
  <summary class="text-[13.5px] text-accent hover:text-accent-hover">Termos para preencher os perfis</summary>
  <div class="mt-3 grid gap-3 text-sm">
    <% { "Títulos" => keywords["titles"], "Skills" => keywords["skills"], "Plano B" => keywords["plan_b"] }.compact_blank.each do |label, terms| %>
      <div>
        <p class="label"><%= label %></p>
        <div class="flex flex-wrap gap-1.5"><% terms.each do |term| %><span class="chip"><%= term %></span><% end %></div>
      </div>
    <% end %>
  </div>
</details>
