<%# The frame reloads only this task when one of its filters changes (the searches' links follow the filters). %>
<%= turbo_frame_tag "radar_#{task["key"]}" do %>
  <article id="<%= task["key"] %>" class="scroll-mt-6" aria-labelledby="<%= task["key"] %>_title">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <div class="max-w-[72ch]">
        <h3 id="<%= task["key"] %>_title" class="text-[20px]"><%= task["title"] %></h3>
        <p class="mt-1.5 text-[14.5px] leading-[1.55]"><%= task["action"] %></p>
      </div>
      <% if task["filters"].present? && task["searches"].present? && !task["checkable"] %>
        <%= render "radar/filters", task_key: task["key"], names: task["filters"], filters: @filters, available: @config["filters"] %>
      <% end %>
    </div>

    <% if task["status"] == "linkedin_alert" %>
      <p class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[13.5px]">
        <% if !@gmail_configured %>
          <span class="chip chip-warn"><%= t("radar.gmail_missing") %></span>
          <%= link_to t(".set_up_gmail"), settings_path(anchor: "chaves"), data: { turbo_frame: "_top" } %>
        <% elsif @alerts[:emails].zero? %>
          <span class="chip chip-warn"><%= t(".no_alerts_chip") %></span>
          <span class="text-muted"><%= t(".no_alerts") %></span>
        <% else %>
          <span class="chip chip-hot"><%= t(".working") %></span>
          <span class="text-muted"><%= t(".alerts_read", count: @alerts[:emails], date: l(@alerts[:last_received_at], format: :day_month_hour)) %></span>
        <% end %>
      </p>
    <% end %>

    <% if task["checkable"] %>
      <%= render "radar/alerts", task:, filters: @filters, available: @config["filters"], location: @profile.location %>
    <% elsif task["searches"].present? %>
      <div class="mt-3 flex flex-col">
        <% task["searches"].each do |search| %>
          <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-line py-2" data-controller="clipboard">
            <span class="min-w-0 flex-[0_0_14rem] text-[14.5px] font-medium">
              <%= search["title"] %>
              <% if search["note"] %><span class="block text-[12.5px] font-normal text-muted"><%= search["note"] %></span><% end %>
            </span>
            <code class="min-w-0 flex-[1_1_300px] font-mono text-[12.5px] leading-[1.55] wrap-anywhere text-ink-soft" translate="no" data-clipboard-target="source"><%= search["query"] %></code>
            <span class="flex flex-none gap-1">
              <button type="button" class="btn btn-ghost btn-sm" data-clipboard-target="button" data-action="clipboard#copy" aria-label="<%= t(".copy_label", title: search["title"]) %>"><%= t(".copy") %></button>
              <%= link_to t(".open"), Radar.url_for(search["builder"], search["query"], @filters, location: @profile.location), class: "btn btn-sm", target: "_blank", rel: "noopener", aria: { label: t(".open_label", title: search["title"]) } %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if task["links"].present? %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% task["links"].each do |site| %>
          <%= external_link "#{site["name"]} ↗", site["url"], class: "btn btn-sm", title: site["note"], translate: "no" %>
        <% end %>
      </div>
    <% end %>

    <% if task["more"] || task["link"] %>
      <p class="mt-3 text-[13.5px] leading-normal text-muted">
        <%= task["more"] %>
        <% if (link = task["link"]) %><%= external_link "#{link["label"]} ↗", link["url"] %><% end %>
      </p>
    <% end %>

    <%= render "radar/registrations", registrations: @registrations, keywords: Radar.profile_keywords(@profile) if task["registrations"] %>
  </article>
<% end %>
