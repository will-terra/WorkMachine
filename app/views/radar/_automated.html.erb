<div class="mt-2 table-scroll">
  <table class="table min-w-[680px]">
    <thead><tr><th><%= t(".source") %></th><th><%= t(".last_run") %></th><th class="text-right"><%= t(".read") %></th><th class="text-right"><%= t(".new") %></th><th><%= t(".status") %></th></tr></thead>
    <tbody>
      <% automated.each do |source| %>
        <tr>
          <td>
            <% if source.app_link %>
              <%= link_to source.name, public_send(source.app_link), class: "font-semibold text-ink no-underline hover:underline" %>
            <% else %>
              <%= external_link source.name, source.url, class: "font-semibold text-ink no-underline hover:underline" %>
            <% end %>
            <span class="block text-[12.5px] leading-[1.4] text-muted"><%= source.failed && source.error_message ? source.error_message : source.note %></span>
          </td>
          <td class="font-mono text-[12.5px] whitespace-nowrap"><%= short_time(source.last_run_at) %></td>
          <td class="text-right font-mono text-[12.5px]"><%= source.fetched_count %></td>
          <td class="text-right font-mono text-[12.5px]"><%= source.created_count %></td>
          <td class="whitespace-nowrap">
            <% if source.needs_gmail? && !gmail_configured %>
              <%= link_to t("radar.gmail_missing"), settings_path(anchor: "chaves"), class: "chip chip-warn" %>
            <% elsif source.off %>
              <span class="chip chip-outline"><%= t(".off") %></span>
            <% elsif source.last_run_at.nil? %>
              <span class="text-[12.5px] text-muted"><%= t(".never") %></span>
            <% elsif source.failed %>
              <span class="chip chip-warn" title="<%= source.error_message %>"><%= t(".failed") %></span>
            <% else %>
              <span class="chip">ok</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
