<% failed = automated.select(&:failed) %>
<% off = automated.count(&:off) %>
<% ok = automated.count { it.last_run_at && !it.failed && !it.off } %>
<details id="automatico" class="group scroll-mt-6 border-y border-line py-2.5" aria-label="<%= t(".label") %>">
  <summary class="flex list-none flex-wrap items-center justify-between gap-x-6 gap-y-2 [&::-webkit-details-marker]:hidden">
    <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
      <span><%= t(".summary", count: automated.size, ok:) %></span>
      <% if failed.any? || off.positive? || !gmail_configured %>
        <span class="font-mono text-[12.5px] text-warn-strong"><%= [ (t(".failed", count: failed.size, names: failed.map(&:name).to_sentence) if failed.any?),
                                                                     (t(".off", count: off) if off.positive?),
                                                                     (t("radar.gmail_missing") unless gmail_configured) ].compact.join(" · ") %></span>
      <% end %>
    </span>
    <span class="btn btn-ghost btn-sm"><span class="group-open:hidden"><%= t(".show") %></span><span class="hidden group-open:inline"><%= t(".hide") %></span></span>
  </summary>
  <%= render "radar/automated", automated:, gmail_configured: %>
</details>
