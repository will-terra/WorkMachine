<% failed = automated.select(&:failed) %>
<% off = automated.count(&:off) %>
<% ok = automated.count { it.last_run_at && !it.failed && !it.off } %>
<details id="automatico" class="group scroll-mt-6 border-y border-line py-2.5" aria-label="Fontes automáticas">
  <summary class="flex list-none flex-wrap items-center justify-between gap-x-6 gap-y-2 [&::-webkit-details-marker]:hidden">
    <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm">
      <span>O WorkMachine consulta <%= automated.size %> fontes sozinho: <%= ok %> ok</span>
      <% if failed.any? || off.positive? || !gmail_configured %>
        <span class="font-mono text-[12.5px] text-warn-strong"><%= [ ("#{failed.size} com erro (#{failed.map(&:name).to_sentence})" if failed.any?),
                                                                     ("#{off} #{off == 1 ? "desligada" : "desligadas"}" if off.positive?),
                                                                     ("Gmail não configurado" unless gmail_configured) ].compact.join(" · ") %></span>
      <% end %>
    </span>
    <span class="btn btn-ghost btn-sm"><span class="group-open:hidden">Ver fontes</span><span class="hidden group-open:inline">Esconder fontes</span></span>
  </summary>
  <%= render "radar/automated", automated:, gmail_configured: %>
</details>
