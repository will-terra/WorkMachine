<%# On top of the Radar while there is something to do with the LinkedIn alerts: how many are left to
    turn on, or old ones to turn off. With every alert on, it goes away. %>
<% if summary && !summary.done? %>
  <p class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2" role="status">
    <% if summary.pending.positive? %><span class="chip chip-warn"><%= t(".pending", count: summary.pending) %></span><% end %>
    <% if summary.outdated.positive? %><span class="chip chip-warn"><%= t(".outdated", count: summary.outdated) %></span><% end %>
    <a href="#linkedin_alerts"><%= t(".link") %></a>
  </p>
<% end %>
