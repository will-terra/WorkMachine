<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
  <nav class="seg" aria-label="<%= t(".frequency") %>">
    <% @config["cadences"].each do |cadence| %>
      <a href="#<%= cadence["key"] %>" class="seg-opt">
        <%= cadence["title"] %>
        <% if @tasks.fetch(cadence["key"], []).any? { it["checkable"] } %>
          <% pending = @alerts_summary&.pending.to_i %>
          <span id="pending_alerts_count" class="font-mono text-[11.5px] text-accent"<% if pending.positive? %> title="<%= t(".pending_alerts", count: pending) %>"<% end %>><%= pending if pending.positive? %></span>
        <% end %>
      </a>
    <% end %>
  </nav>
<% end %>

<% unless @profile.configured? %>
  <p class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2" role="status">
    <span class="chip chip-warn"><%= t(".empty_profile") %></span>
    <span><%= t(".empty_profile_html", link: link_to(t(".fill_profile"), profile_path)) %></span>
  </p>
<% end %>

<div id="alerts_summary"><%= render "radar/alerts_summary", summary: @alerts_summary %></div>

<%= render "radar/status", automated: @automated, gmail_configured: @gmail_configured %>

<%# Every frequency on the same page, "Uma vez" last; the buttons on top only jump to each one. %>
<div data-controller="open-linked radar-folds" data-action="hashchange@window->open-linked#open">
  <% @config["cadences"].each do |cadence| %>
    <section id="<%= cadence["key"] %>" class="mt-12 scroll-mt-6" aria-labelledby="<%= cadence["key"] %>_title">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line pb-3">
        <h2 id="<%= cadence["key"] %>_title" class="text-[26px] text-accent"><%= cadence["title"] %></h2>
        <p class="font-mono text-xs text-muted"><%= cadence["time"] %></p>
      </div>
      <div class="flex flex-col gap-8 pt-6">
        <% @tasks.fetch(cadence["key"], []).each do |task| %>
          <%= render "radar/task", task: %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
