<div data-controller="cadence" data-action="hashchange@window->cadence#follow">
  <%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
    <div class="seg" role="radiogroup" aria-label="<%= t(".frequency") %>">
      <% @config["cadences"].each_with_index do |cadence, index| %>
        <label class="seg-opt">
          <%= radio_button_tag :cadence, cadence["key"], index.zero?, id: "cadence_#{cadence["key"]}", data: { cadence_target: "option", action: "cadence#change" } %>
          <%= cadence["title"] %>
          <% if @tasks.fetch(cadence["key"], []).any? { it["checkable"] } %>
            <% pending = @alerts_summary&.pending.to_i %>
            <span id="pending_alerts_count" class="font-mono text-[11.5px]"<% if pending.positive? %> title="<%= t(".pending_alerts", count: pending) %>"<% end %>><%= pending if pending.positive? %></span>
          <% end %>
        </label>
      <% end %>
    </div>
  <% end %>

  <% unless @profile.configured? %>
    <p class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2" role="status">
      <span class="chip chip-warn"><%= t(".empty_profile") %></span>
      <span><%= t(".empty_profile_html", link: link_to(t(".fill_profile"), profile_path)) %></span>
    </p>
  <% end %>

  <div id="alerts_summary"><%= render "radar/alerts_summary", summary: @alerts_summary %></div>

  <%= render "radar/status", automated: @automated, gmail_configured: @gmail_configured %>

  <% @config["cadences"].each do |cadence| %>
    <section id="<%= cadence["key"] %>" class="scroll-mt-6" data-cadence-target="panel" data-cadence="<%= cadence["key"] %>" aria-label="<%= cadence["title"] %>">
      <p class="mt-6 font-mono text-xs text-muted"><%= cadence["time"] %></p>
      <div class="flex flex-col gap-11 pt-3.5">
        <% @tasks.fetch(cadence["key"], []).each do |task| %>
          <%= render "radar/task", task: %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
