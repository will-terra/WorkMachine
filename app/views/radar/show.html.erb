<%= page_header eyebrow: "Radar", title: "O que fazer à mão",
                intro: "Só o que o WorkMachine não consegue buscar sozinho, por frequência. As vagas das fontes automáticas já chegam em Vagas, com nota." do %>
  <%= link_to "Vagas novas (#{@new_postings_count})", job_postings_path, class: "btn btn-primary btn-sm" %>
<% end %>

<% unless @profile.configured? %>
  <p class="card mb-6 p-4 text-sm" role="status">
    As buscas saem do seu perfil. <%= link_to "Preencha o perfil", profile_path, class: "font-semibold" %> (área, cargos e skills) para o Radar montar todas.
  </p>
<% end %>

<%= render "radar/status", automated: @automated, gmail_configured: @gmail_configured %>

<nav class="mb-2 flex flex-wrap gap-1" aria-label="Frequência">
  <% @config["cadences"].each do |cadence| %>
    <a href="#<%= cadence["key"] %>" class="nav-link border border-line bg-surface"><%= cadence["title"] %></a>
  <% end %>
</nav>

<% number = 0 %>
<% @config["cadences"].each do |cadence| %>
  <section id="<%= cadence["key"] %>" class="mt-10 scroll-mt-20" aria-labelledby="<%= cadence["key"] %>_title">
    <div class="flex flex-wrap items-baseline gap-x-3 border-b border-line pb-2">
      <h2 id="<%= cadence["key"] %>_title"><%= cadence["title"] %></h2>
      <span class="muted text-sm"><%= cadence["time"] %></span>
    </div>
    <% @tasks.fetch(cadence["key"], []).each do |task| %>
      <%= render "radar/task", task:, number: number += 1 %>
    <% end %>
  </section>
<% end %>
