<%= form_with model: contact, class: "card grid gap-4 p-5 sm:grid-cols-2" do |form| %>
  <div class="sm:col-span-2"><%= render "shared/errors", record: contact %></div>
  <div>
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, required: true, class: "input" %>
  </div>
  <div>
    <%= form.label :headline, class: "label" %>
    <%= form.text_field :headline, placeholder: "Tech Recruiter na Acme", class: "input" %>
  </div>
  <div>
    <%= form.label :company, class: "label" %>
    <%= form.text_field :company, class: "input" %>
  </div>
  <div>
    <%= form.label :linkedin_url, class: "label" %>
    <%= form.url_field :linkedin_url, placeholder: "https://www.linkedin.com/in/…", class: "input" %>
  </div>
  <div>
    <%= form.label :kind, class: "label" %>
    <%= form.select :kind, Contact.enum_options(:kind), {}, class: "input" %>
  </div>
  <div>
    <%= form.label :last_contacted_on, class: "label" %>
    <%= form.date_field :last_contacted_on, class: "input" %>
  </div>
  <div class="sm:col-span-2">
    <%= form.label :notes, class: "label" %>
    <%= form.text_area :notes, rows: 3, class: "input" %>
  </div>
  <div class="flex gap-2 sm:col-span-2">
    <%= form.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", contacts_path, class: "btn btn-ghost" %>
  </div>
<% end %>
