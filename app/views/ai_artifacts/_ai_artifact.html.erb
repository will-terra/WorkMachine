<%= turbo_frame_tag dom_id(ai_artifact) do %>
  <article class="card" <% if ai_artifact.status_pending? %>data-controller="poll" data-poll-url-value="<%= ai_artifact_path(ai_artifact) %>"<% end %>>
    <header class="flex flex-wrap items-baseline justify-between gap-2">
      <h3><%= ai_artifact.human_enum(:kind) %><% if ai_artifact.message? %> (<%= ai_artifact.language.to_s.upcase %>)<% end %></h3>
      <span class="font-mono text-[11.5px] text-muted">
        <%= l(ai_artifact.created_at, format: :day_month_hour) %>
        <% if ai_artifact.cost_usd %> · US$ <%= number_with_precision(ai_artifact.cost_usd, precision: 4) %><% end %>
        <% if ai_artifact.model.present? %> · <%= ai_artifact.model %><% end %>
      </span>
    </header>

    <% case ai_artifact.status %>
    <% when "pending" %>
      <p class="text-sm text-muted" role="status"><%= t(".pending") %></p>
    <% when "failed" %>
      <p class="text-sm font-semibold text-warn-strong" role="alert"><%= ai_artifact.error_message %></p>
    <% else %>
      <div data-controller="clipboard">
        <p class="text-[15px] leading-relaxed whitespace-pre-line" data-clipboard-target="source"><%= ai_artifact.content %></p>
        <div class="mt-3 flex gap-2">
          <button type="button" class="btn btn-sm" data-clipboard-target="button" data-action="clipboard#copy"><%= t(".copy") %></button>
          <%= button_to t(".delete"), ai_artifact_path(ai_artifact), method: :delete, class: "btn btn-ghost btn-sm", form: { data: { turbo_frame: ai_artifact.interview_prep? ? "_top" : "posting_detail", turbo_confirm: t(".delete_confirm") } } %>
        </div>
      </div>
    <% end %>
  </article>
<% end %>
