<%= turbo_frame_tag "ai_estimate" do %>
  <% if Ai::Client.free? %>
    <p class="text-xs text-muted"><%= t(".free") %></p>
  <% elsif @estimates %>
    <p class="text-xs text-muted">
      <%= t(".estimate", costs: @estimates.map { |kind, cost| "#{AiArtifact.human_enum(:kind, kind).downcase} ≈ US$ #{number_with_precision(cost, precision: 3)}" }.join(" · ")) %>
    </p>
  <% end %>
<% end %>
