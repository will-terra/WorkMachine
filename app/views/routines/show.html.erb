<%= page_header eyebrow: "checklist", title: "Rotina",
                intro: "O que fazer a cada dia, ajustado ao que o WorkMachine já automatiza. Os itens da semana ficam marcados até domingo, os de configuração ficam marcados de vez e os outros recomeçam todo dia." do %>
  <%= link_to "Editar rotinas", settings_routines_path, class: "btn btn-sm" %>
<% end %>

<% @routines.each do |routine| %>
  <% done, total = routine.progress(@checked) %>
  <details id="<%= dom_id(routine) %>" class="group mb-12 scroll-mt-6" <%= "open" unless routine.once? && done == total %>>
    <summary class="mb-5 flex cursor-pointer list-none flex-wrap items-center justify-between gap-x-6 gap-y-2.5 border-b border-line pb-3">
      <span>
        <span class="flex items-baseline gap-2">
          <span class="font-mono text-xs text-muted group-open:rotate-90" aria-hidden="true">▸</span>
          <h2><%= routine.name %></h2>
        </span>
        <% if routine.description.present? %><span class="mt-1 block text-sm text-muted"><%= routine.description %></span><% end %>
      </span>
      <%= render "routines/progress", routine:, checked: @checked, track: "h-[5px] w-[140px] rounded-[3px]" %>
    </summary>
    <%= render "routines/checklist", routine:, checked: @checked, full: true %>
  </details>
<% end %>

<% if @routines.empty? %>
  <p class="text-muted">Nenhuma rotina. Crie uma ou restaure as prontas em <%= link_to "Ajustes → Rotinas", settings_routines_path %>.</p>
<% end %>

<section id="regras" class="mt-14 max-w-[76ch] scroll-mt-6" aria-labelledby="rules_title">
  <h2 id="rules_title">Regras</h2>
  <ol class="mt-3.5 flex flex-col gap-3">
    <% Routine.rules.each_with_index do |rule, index| %>
      <li class="grid grid-cols-[28px_minmax(0,1fr)] gap-2 text-[15px] leading-[1.55]">
        <span class="font-mono text-[13px] text-accent-bright"><%= format("%02d", index + 1) %></span>
        <span><strong class="font-semibold"><%= rule["title"] %></strong> <%= rule["text"] %></span>
      </li>
    <% end %>
  </ol>
</section>
