<%# Locals: routine, checked, full (the Rotina page: bigger titles and text; the Painel uses the compact one). %>
<% full = local_assigns[:full] %>
<div class="grid <%= full ? "grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-5" : "mt-4 grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-3.5" %>">
  <% routine.slots.each do |slot| %>
    <section class="rounded-xl border border-line bg-surface <%= full ? "px-5 py-4" : "px-4 py-3.5" %>">
      <div class="flex items-baseline gap-2 <%= full ? "mb-2.5" : "mb-1.5" %>">
        <%= tag.h3 slot.title, class: ("text-lg" if full) %>
        <span class="font-mono text-muted <%= full ? "text-xs" : "text-[11.5px]" %>"><%= slot.time %></span>
      </div>
      <ul class="flex flex-col <%= full ? "gap-1 text-[15px] leading-normal" : "gap-0.5 text-[13.5px] leading-[1.4]" %>">
        <% slot.items.each do |item| %>
          <%= render "routines/item", item:, checked: checked.include?(item.key) %>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
