<%# Locals: checked, track (size of the bar). The toggle answer updates the bar and the count by id. %>
<% done, total = Routine.progress(checked) %>
<span class="flex items-center gap-2.5 font-mono text-xs text-muted">
  <span class="block overflow-hidden rounded-sm bg-field <%= track %>" aria-hidden="true">
    <%= render "routines/progress_bar", done:, total: %>
  </span>
  <span id="routine_progress_text"><%= done %>/<%= total %> feitos</span>
</span>
