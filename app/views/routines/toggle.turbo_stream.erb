<%= turbo_stream.replace "routine_item_#{@item.key}", partial: "routines/item", locals: { item: @item, checked: @checked.include?(@item.key) } %>
<% done, total = Routine.progress(@checked) %>
<%= turbo_stream.replace "routine_progress_bar", partial: "routines/progress_bar", locals: { done:, total: } %>
<%= turbo_stream.update "routine_progress_text", "#{done}/#{total} feitos" %>
