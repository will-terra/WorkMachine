<%# Columns: one series in the accent, 24px max, 4px rounded tip, hairline grid; tooltip on hover/focus; table twin. %>
<% top = [ weeks.map(&:last).max.to_i, 1 ].max %>
<% top += 1 if top.odd? && top > 1 %>
<% highlighted = [ weeks.max_by(&:last)&.first, weeks.last&.first ].compact %>
<% step = weeks.size > 13 ? 2 : 1 %>
<figure class="card m-0 p-4" aria-labelledby="weekly_title">
  <figcaption>
    <h2 id="weekly_title" class="text-base">Candidaturas por semana</h2>
    <p class="muted text-xs">Semanas de segunda a domingo; a última é a atual.</p>
  </figcaption>

  <div class="mt-4 grid grid-cols-[auto_minmax(0,1fr)] gap-x-2">
    <div class="relative h-40 w-6 text-right font-mono text-[11px] text-muted tabular-nums" aria-hidden="true">
      <span class="absolute right-0 top-0 -translate-y-1/2"><%= top %></span>
      <span class="absolute right-0 top-1/2 -translate-y-1/2"><%= top / 2 %></span>
      <span class="absolute bottom-0 right-0 translate-y-1/2">0</span>
    </div>
    <div class="relative h-40">
      <div class="absolute inset-x-0 top-0 border-t border-line" aria-hidden="true"></div>
      <div class="absolute inset-x-0 top-1/2 border-t border-line" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 border-t border-line" aria-hidden="true"></div>
      <ol class="relative flex h-full items-end gap-0.5">
        <% weeks.each do |monday, count| %>
          <li class="group relative flex h-full flex-1 items-end justify-center outline-none" tabindex="0"
              aria-label="Semana de <%= l(monday, format: "%d/%m") %>: <%= pluralize(count, "candidatura", plural: "candidaturas") %>">
            <% if count.positive? %>
              <div class="w-full max-w-6 rounded-t-[4px] bg-accent transition group-hover:brightness-110 group-focus-visible:brightness-110" style="height: <%= (count * 100.0 / top).round(2) %>%"></div>
              <% if highlighted.include?(monday) %>
                <span class="pointer-events-none absolute font-mono text-[11px] text-ink tabular-nums" style="bottom: calc(<%= (count * 100.0 / top).round(2) %>% + 2px)"><%= count %></span>
              <% end %>
            <% end %>
            <span class="pointer-events-none absolute bottom-full z-10 mb-2 hidden whitespace-nowrap rounded-md bg-ink px-2 py-1 text-xs text-bg shadow group-hover:block group-focus-visible:block">
              <strong><%= count %></strong> · semana de <%= l(monday, format: "%d/%m") %>
            </span>
          </li>
        <% end %>
      </ol>
    </div>
    <div></div>
    <ol class="mt-1 flex gap-0.5 font-mono text-[11px] text-muted" aria-hidden="true">
      <% weeks.each_with_index do |(monday, _), index| %>
        <li class="flex-1 text-center"><%= l(monday, format: "%d/%m") if (weeks.size - 1 - index) % step == 0 %></li>
      <% end %>
    </ol>
  </div>

  <details class="mt-3">
    <summary class="cursor-pointer text-xs text-muted">Ver tabela</summary>
    <table class="table mt-2 tabular-nums">
      <thead><tr><th>Semana de</th><th class="text-right">Candidaturas</th></tr></thead>
      <tbody><% weeks.reverse_each do |monday, count| %><tr><td><%= l(monday, format: "%d/%m/%Y") %></td><td class="text-right"><%= count %></td></tr><% end %></tbody>
    </table>
  </details>
</figure>
