<%# Horizontal bars in the ordinal ramp of the accent, 20px thick, with the share of the previous stage under each one. %>
<% ramp = %w[bg-ramp-1 bg-ramp-2 bg-ramp-3 bg-ramp-4] %>
<figure class="m-0 min-w-0 flex-[1_1_420px]" aria-labelledby="funnel_title">
  <figcaption>
    <h2 id="funnel_title" class="text-2xl"><%= t(".title") %></h2>
    <p class="mt-1.5 text-sm text-ink/70"><%= t(".note") %></p>
  </figcaption>
  <ol class="mt-8 flex flex-col gap-[22px]">
    <% stages.each_with_index do |stage, index| %>
      <% previous = index.zero? ? nil : stages[index - 1] %>
      <li class="grid grid-cols-[minmax(0,10rem)_minmax(0,1fr)] items-center gap-x-4 gap-y-1.5" aria-label="<%= stage.label %>: <%= stage.count %> (<%= stage.rate %>%)">
        <span class="text-[15px] leading-[1.3]"><%= stage.label %></span>
        <span class="flex min-w-0 items-center gap-2.5">
          <% if stage.count.positive? %>
            <span class="h-5 flex-none rounded-r-[2px] <%= ramp[index] %>" style="width: max(4px, <%= stage.rate * 0.82 %>%)"></span>
          <% end %>
          <span class="text-sm whitespace-nowrap tabular-nums"><strong class="font-semibold"><%= stage.count %></strong> <span class="text-ink/70">· <%= stage.rate %>%</span></span>
        </span>
        <% if previous&.count.to_i.positive? %>
          <span></span>
          <span class="text-[13px] text-ink/70"><%= t(".of_previous", rate: (stage.count * 100.0 / previous.count).round, previous: previous.label) %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
  <details class="mt-4">
    <summary class="text-xs text-muted"><%= t("metrics.see_table") %></summary>
    <table class="table mt-2 tabular-nums">
      <thead><tr><th><%= t(".stage") %></th><th class="text-right"><%= t(".applications") %></th><th class="text-right"><%= t(".share") %></th></tr></thead>
      <tbody><% stages.each do |stage| %><tr><td><%= stage.label %></td><td class="text-right"><%= stage.count %></td><td class="text-right"><%= stage.rate %>%</td></tr><% end %></tbody>
    </table>
  </details>
</figure>
