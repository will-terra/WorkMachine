<%= page_header eyebrow: "funil", title: "Métricas",
                intro: "Como suas candidaturas andam e de onde vêm as melhores vagas. As respostas vêm dos e-mails lidos no Gmail e das mudanças que você faz no kanban." do %>
  <div>
    <p class="label">Período</p>
    <nav class="seg" aria-label="Período">
      <% FunnelMetrics::PERIODS.each do |key, (_, label)| %>
        <%= link_to label, metrics_path(period: key), class: "seg-opt", aria: { current: (key == @metrics.period ? "true" : nil) } %>
      <% end %>
    </nav>
  </div>
<% end %>

<% if @metrics.applied.zero? %>
  <p class="py-10 text-[15px] text-muted">Nenhuma candidatura aplicada neste período.</p>
<% else %>
  <section class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,210px),1fr))] gap-x-12 gap-y-9 pt-11 pb-20" aria-label="Resumo">
    <%= render "metrics/tile", label: "Candidaturas aplicadas", value: @metrics.applied, detail: "no período" %>
    <%= render "metrics/tile", label: "Taxa de resposta", value: "#{@metrics.response_rate}%", detail: "#{@metrics.answered} de #{@metrics.applied} responderam" %>
    <%= render "metrics/tile", label: "Chegaram à entrevista", value: "#{@metrics.interview_rate}%", detail: "#{@metrics.interviewed} entrevistas ou testes" %>
    <%= render "metrics/tile", label: "Tempo até a resposta", value: (@metrics.median_days_to_answer ? pluralize(@metrics.median_days_to_answer, "dia", plural: "dias") : "—"), detail: "mediana entre aplicar e a primeira resposta" %>
  </section>

  <div class="flex flex-wrap gap-x-[clamp(40px,6vw,96px)] gap-y-16 pb-[88px]">
    <%= render "metrics/weekly", weeks: @metrics.weekly %>
    <%= render "metrics/funnel", stages: @metrics.funnel %>
  </div>
<% end %>

<div class="flex flex-wrap gap-x-[clamp(40px,6vw,96px)] gap-y-16">
  <% unless @metrics.applied.zero? %>
    <section class="min-w-0 flex-[3_1_520px]" aria-labelledby="origin_title">
      <h2 id="origin_title" class="text-2xl">Por origem da candidatura</h2>
      <p class="mt-1.5 mb-5 text-sm text-ink/70">Onde você achou a vaga e quanto cada origem rende em respostas e entrevistas.</p>
      <div class="overflow-x-auto">
        <table class="table min-w-[560px] tabular-nums">
          <thead><tr><th>Origem</th><th class="text-right">Aplicadas</th><th class="text-right">Responderam</th><th class="text-right">Taxa de resposta</th><th class="text-right">Entrevistas</th><th class="text-right">Taxa de entrevista</th></tr></thead>
          <tbody>
            <% @metrics.by_origin.each do |group| %>
              <tr>
                <td class="font-semibold"><%= group.name %></td>
                <td class="text-right"><%= group.total %></td>
                <td class="text-right"><%= group.answered %></td>
                <td class="text-right"><%= group.response_rate %>%</td>
                <td class="text-right"><%= group.interviewed %></td>
                <td class="text-right"><%= group.interview_rate %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="min-w-0 flex-[2_1_380px]" aria-labelledby="sources_title">
    <h2 id="sources_title" class="text-2xl">Fontes de vagas</h2>
    <p class="mt-1.5 mb-5 text-sm text-ink/70">Quantas vagas cada fonte trouxe no período e quantas você salvou: as do topo são as que mais valem o seu tempo.</p>
    <div class="overflow-x-auto">
      <table class="table min-w-[380px] tabular-nums">
        <thead><tr><th>Fonte</th><th class="text-right">Vagas</th><th class="text-right">Salvas</th><th class="text-right">Aproveitamento</th></tr></thead>
        <tbody>
          <% @metrics.by_source.each do |source| %>
            <tr>
              <td class="font-semibold"><%= JobPosting.human_enum(:source, source.source) %></td>
              <td class="text-right"><%= source.total %></td>
              <td class="text-right"><%= source.saved %></td>
              <td class="text-right"><%= source.saved_rate %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
