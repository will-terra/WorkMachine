<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
  <div>
    <p class="label"><%= t(".period") %></p>
    <nav class="seg" aria-label="<%= t(".period") %>">
      <% FunnelMetrics::PERIODS.each_key do |key| %>
        <%= link_to t(".periods.p#{key}"), metrics_path(period: key), class: "seg-opt", aria: { current: (key == @metrics.period ? "true" : nil) } %>
      <% end %>
    </nav>
  </div>
<% end %>

<% if @metrics.applied.zero? %>
  <p class="py-10 text-[15px] text-muted"><%= t(".empty") %></p>
<% else %>
  <section class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,210px),1fr))] gap-x-12 gap-y-9 pt-11 pb-20 max-sm:grid-cols-2 max-sm:gap-x-5 max-sm:gap-y-7 max-sm:pt-3 max-sm:pb-14" aria-label="<%= t(".summary") %>">
    <%= render "metrics/tile", label: t(".tiles.applied"), value: @metrics.applied, detail: t(".tiles.applied_detail") %>
    <%= render "metrics/tile", label: t(".tiles.response_rate"), value: "#{@metrics.response_rate}%", detail: t(".tiles.response_rate_detail", answered: @metrics.answered, applied: @metrics.applied) %>
    <%= render "metrics/tile", label: t(".tiles.interview_rate"), value: "#{@metrics.interview_rate}%", detail: t(".tiles.interview_rate_detail", count: @metrics.interviewed) %>
    <%= render "metrics/tile", label: t(".tiles.days"), value: (@metrics.median_days_to_answer ? t(".tiles.days_value", count: @metrics.median_days_to_answer) : "—"), detail: t(".tiles.days_detail") %>
  </section>

  <div class="flex flex-wrap gap-x-[clamp(40px,6vw,96px)] gap-y-16 pb-[88px]">
    <%= render "metrics/weekly", weeks: @metrics.weekly %>
    <%= render "metrics/funnel", stages: @metrics.funnel %>
  </div>
<% end %>

<div class="flex flex-wrap gap-x-[clamp(40px,6vw,96px)] gap-y-16">
  <% unless @metrics.applied.zero? %>
    <section class="min-w-0 flex-[3_1_520px]" aria-labelledby="origin_title">
      <h2 id="origin_title" class="text-2xl"><%= t(".origin.title") %></h2>
      <p class="mt-1.5 mb-5 text-sm text-ink/70"><%= t(".origin.note") %></p>
      <div class="table-scroll">
        <table class="table min-w-[560px] tabular-nums">
          <thead><tr><th><%= t(".origin.origin") %></th><th class="text-right"><%= t(".origin.applied") %></th><th class="text-right"><%= t(".origin.answered") %></th><th class="text-right"><%= t(".origin.response_rate") %></th><th class="text-right"><%= t(".origin.interviews") %></th><th class="text-right"><%= t(".origin.interview_rate") %></th></tr></thead>
          <tbody>
            <% @metrics.by_origin.each do |group| %>
              <tr>
                <td class="font-semibold"><%= group.name %></td>
                <td class="text-right"><%= group.total %></td>
                <td class="text-right"><%= group.answered %></td>
                <td class="text-right"><%= group.response_rate %>%</td>
                <td class="text-right"><%= group.interviewed %></td>
                <td class="text-right"><%= group.interview_rate %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="min-w-0 flex-[2_1_380px]" aria-labelledby="sources_title">
    <h2 id="sources_title" class="text-2xl"><%= t(".sources.title") %></h2>
    <p class="mt-1.5 mb-5 text-sm text-ink/70"><%= t(".sources.note") %></p>
    <div class="table-scroll">
      <table class="table min-w-[380px] tabular-nums">
        <thead><tr><th><%= t(".sources.source") %></th><th class="text-right"><%= t(".sources.postings") %></th><th class="text-right"><%= t(".sources.saved") %></th><th class="text-right"><%= t(".sources.rate") %></th></tr></thead>
        <tbody>
          <% @metrics.by_source.each do |source| %>
            <tr>
              <td class="font-semibold"><%= JobPosting.human_enum(:source, source.source) %></td>
              <td class="text-right"><%= source.total %></td>
              <td class="text-right"><%= source.saved %></td>
              <td class="text-right"><%= source.saved_rate %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
