<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= [ content_for(:title), "WorkMachine" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WorkMachine">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#a8132d">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <% if authenticated? %>
      <header class="sticky top-0 z-10 border-b border-line bg-surface">
        <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-2">
          <%= link_to root_path, class: "font-mono text-sm font-semibold text-ink no-underline whitespace-nowrap" do %>
            <span class="text-accent">$</span> work_machine
          <% end %>
          <nav class="flex flex-1 gap-1 overflow-x-auto" aria-label="Seções">
            <% nav_items.each do |label, path| %>
              <%= nav_link label, path %>
            <% end %>
          </nav>
          <%= link_to "Perfil", profile_path, class: [ "nav-link", ("nav-link-active" if request.path.start_with?(profile_path)) ] %>
          <%= link_to "Ajustes", settings_path, class: [ "nav-link", ("nav-link-active" if request.path.start_with?(settings_path)) ] %>
          <%= button_to "Sair", session_path, method: :delete, class: "btn btn-ghost btn-sm", form: { data: { turbo_confirm: "Sair do WorkMachine?" } } %>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>

    <footer class="muted mx-auto max-w-6xl px-4 pb-8 text-xs">
      WorkMachine <%= AppVersion.current %> · código aberto sob a
      <%= link_to "AGPL-3.0", "https://github.com/will-terra/WorkMachine/blob/main/LICENSE", class: "text-muted underline" %> ·
      <%= link_to "código-fonte", "https://github.com/will-terra/WorkMachine", class: "text-muted underline" %>
    </footer>
  </body>
</html>
