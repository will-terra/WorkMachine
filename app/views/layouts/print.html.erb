<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%# A sheet of paper: black on white, one column and a plain font, which is what applicant tracking systems read best. %>
    <style>
      @page { size: A4; margin: 16mm 18mm; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #e9e6e4; color: #111; font: 10.5pt/1.45 Helvetica, Arial, sans-serif; }
      .toolbar { position: sticky; top: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; padding: 12px 20px; background: #121010; color: #ece6e3; font: 14px/1.4 system-ui, sans-serif; }
      .toolbar a { color: #ffa3a3; }
      .toolbar button { cursor: pointer; border: 0; border-radius: 2px; background: #c7262f; color: #fff; padding: 9px 16px; font: 600 14px system-ui, sans-serif; }
      .toolbar .coverage { flex: 1 1 320px; color: #d0cac8; font-size: 13px; }
      .toolbar .missing { color: #f5c060; }
      .paper { max-width: 210mm; margin: 24px auto 48px; padding: 16mm 18mm; background: #fff; box-shadow: 0 2px 18px #0003; }
      h1 { margin: 0 0 2pt; font-size: 20pt; line-height: 1.15; }
      h2 { margin: 14pt 0 5pt; padding-bottom: 2pt; border-bottom: 1px solid #999; font-size: 11.5pt; text-transform: uppercase; letter-spacing: .04em; }
      h3 { margin: 9pt 0 3pt; font-size: 10.5pt; }
      p { margin: 0 0 4pt; }
      ul { margin: 0 0 4pt; padding-left: 14pt; }
      li { margin-bottom: 2pt; }
      @media print {
        body { background: #fff; }
        .toolbar { display: none; }
        .paper { max-width: none; margin: 0; padding: 0; box-shadow: none; }
        h2, h3 { break-after: avoid; }
        li { break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
