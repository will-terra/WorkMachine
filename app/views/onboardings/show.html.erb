<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") %>

<ol class="grid gap-6">
  <li class="grid gap-3">
    <h2 class="flex items-center gap-2 text-base">
      <span class="chip <%= @steps[:keys] ? "chip-ok" : "chip-warn" %>"><%= @steps[:keys] ? t(".done") : "1" %></span> <%= t(".keys.title") %>
    </h2>
    <p class="muted max-w-prose text-sm"><%= t(".keys.note") %></p>
    <%= render "settings/keys", setting: @setting, return_to: onboarding_path %>
  </li>

  <li class="grid gap-3">
    <h2 class="flex items-center gap-2 text-base">
      <span class="chip <%= @steps[:profile] ? "chip-ok" : "chip-warn" %>"><%= @steps[:profile] ? t(".done") : "2" %></span> <%= t(".profile.title") %>
    </h2>
    <p class="muted max-w-prose text-sm"><%= t(".profile.note") %></p>
    <p><%= link_to @steps[:profile] ? t(".profile.review") : t(".profile.build"), profile_path, class: "btn #{"btn-primary" unless @steps[:profile]}" %></p>
  </li>

  <li class="grid gap-3">
    <h2 class="flex items-center gap-2 text-base"><span class="chip">3</span> <%= t(".extension.title") %></h2>
    <p class="muted max-w-prose text-sm"><%= t(".extension.note_html", store: external_link("Chrome Web Store", ExtensionVersion::STORE_URL)) %></p>
  </li>

  <li class="grid gap-3">
    <h2 class="flex items-center gap-2 text-base">
      <span class="chip <%= @steps[:search] ? "chip-ok" : "" %>"><%= @steps[:search] ? t(".done") : "4" %></span> <%= t(".search.title") %>
    </h2>
    <p class="muted max-w-prose text-sm"><%= t(".search.note") %></p>
    <div class="flex flex-wrap gap-2">
      <% if @steps[:profile] %>
        <%= button_to t(".search.start"), finish_onboarding_path(search: 1), class: "btn btn-primary" %>
      <% else %>
        <span class="muted text-sm"><%= t(".search.profile_first") %></span>
      <% end %>
      <%= button_to t(".search.skip"), finish_onboarding_path, class: "btn btn-ghost" %>
    </div>
  </li>
</ol>
