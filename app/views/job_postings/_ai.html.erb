<section id="ia" class="mt-12 scroll-mt-6 border-t border-line pt-7" aria-labelledby="ai_title">
  <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1">
    <h2 id="ai_title"><%= t(".title") %></h2>
    <span class="font-mono text-xs text-muted"><%= Ai::Client.model %><%= " · #{t(".free")}" if Ai::Client.free? %> · via OpenRouter</span>
  </div>
  <p class="mt-1 text-[13.5px] text-muted"><%= t(".note") %></p>

  <% if Ai::Client.configured? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= button_to t(".fit"), job_posting_ai_artifacts_path(job_posting, kind: "fit_analysis"), class: "btn btn-sm" %>
      <%= button_to t(".cv_summary"), job_posting_ai_artifacts_path(job_posting, kind: "cv_summary"), class: "btn btn-sm" %>
      <%= button_to t(".tailored_cv"), job_posting_ai_artifacts_path(job_posting, kind: "tailored_cv"), class: "btn btn-sm" %>
      <%= button_to t(".message_pt"), job_posting_ai_artifacts_path(job_posting, kind: "message", language: "pt"), class: "btn btn-sm" %>
      <%= button_to t(".message_en"), job_posting_ai_artifacts_path(job_posting, kind: "message", language: "en"), class: "btn btn-sm" %>
    </div>
    <% if Profile.current.cv_text.blank? %>
      <p class="mt-2 text-xs text-muted"><%= t(".no_cv_html", link: link_to(t(".no_cv_link"), profile_path(anchor: "cv"), data: { turbo_frame: "_top" })) %></p>
    <% end %>
    <div class="mt-2.5">
      <%= turbo_frame_tag "ai_estimate", src: estimate_job_posting_ai_artifacts_path(job_posting), loading: "lazy" do %>
        <p class="text-xs text-muted"><%= t(".estimating") %></p>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm"><%= t(".no_key_html", link: link_to(t(".no_key_link"), settings_path(anchor: "chaves"), data: { turbo_frame: "_top" })) %></p>
  <% end %>

  <% if ai_artifacts.any? %>
    <div class="mt-5 flex flex-col gap-3">
      <%= render partial: "ai_artifacts/ai_artifact", collection: ai_artifacts %>
    </div>
  <% end %>
</section>
