<%= page_header eyebrow: "Vagas", title: "Adicionar vaga", intro: "Para vagas vistas em grupos, e-mails ou sites sem fonte automática. A nota é calculada na hora." %>

<%= form_with model: @job_posting, url: job_postings_path, class: "card grid gap-4 p-5 sm:grid-cols-2" do |form| %>
  <div class="sm:col-span-2"><%= render "shared/errors", record: @job_posting %></div>
  <div>
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, class: "input" %>
  </div>
  <div>
    <%= form.label :company, class: "label" %>
    <%= form.text_field :company, class: "input" %>
  </div>
  <div class="sm:col-span-2">
    <%= form.label :url, class: "label" %>
    <%= form.url_field :url, required: true, placeholder: "https://", class: "input" %>
  </div>
  <div>
    <%= form.label :location_text, class: "label" %>
    <%= form.text_field :location_text, placeholder: "Remoto · Brasil", class: "input" %>
  </div>
  <div>
    <%= form.label :salary_text, class: "label" %>
    <%= form.text_field :salary_text, class: "input" %>
  </div>
  <div class="sm:col-span-2">
    <%= form.label :description, class: "label" %>
    <%= form.text_area :description, rows: 8, class: "input" %>
  </div>
  <div class="flex gap-2 sm:col-span-2">
    <%= form.submit "Adicionar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", job_postings_path, class: "btn btn-ghost" %>
  </div>
<% end %>
