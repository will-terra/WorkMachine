<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<div data-controller="refresh-on-return" hidden></div>

<%= page_header eyebrow: "Triagem", title: "Vagas",
                intro: "Vagas do agregador, dos alertas do LinkedIn e da extensão. Salve as que valem a pena e descarte o resto." do %>
  <%= button_to "Buscar agora", fetch_job_postings_path, class: "btn btn-sm" %>
  <%= link_to "Adicionar vaga", new_job_posting_path, class: "btn btn-primary btn-sm" %>
<% end %>

<%= form_with url: job_postings_path, method: :get, class: "card mb-4 grid gap-3 p-4 sm:grid-cols-3 lg:grid-cols-5", data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
  <% submit = { action: "auto-submit#submit" } %>
  <div>
    <%= form.label :sort, "Ordenar por", class: "label" %>
    <%= form.select :sort, JobPostingFilter::SORTS.invert, { selected: @filter[:sort] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :triage, "Triagem", class: "label" %>
    <%= form.select :triage, JobPosting.enum_options(:triage) + [ [ "Todas", "all" ] ], { selected: @filter[:triage] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :min_score, "Nota mínima", class: "label" %>
    <%= form.select :min_score, JobPostingFilter::MIN_SCORES.map { [ "#{it}+", it ] }, { include_blank: "Qualquer", selected: @filter[:min_score] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :period, "Publicadas", class: "label" %>
    <%= form.select :period, JobPostingFilter::PERIODS.map { |value, (_, label)| [ label, value ] }, { include_blank: "Qualquer data", selected: @filter[:period] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :remote_scope, "Região", class: "label" %>
    <%= form.select :remote_scope, [ [ "Abertas ao Brasil", JobPostingFilter::OPEN_TO_BRAZIL ] ] + JobPosting.enum_options(:remote_scope), { include_blank: "Todas", selected: @filter[:remote_scope] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :keyword, "Tecnologia", class: "label" %>
    <%= form.select :keyword, JobPostingFilter.keywords, { include_blank: "Qualquer", selected: @filter[:keyword] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :seniority, "Senioridade", class: "label" %>
    <%= form.select :seniority, JobPosting.enum_options(:seniority), { include_blank: "Todas", selected: @filter[:seniority] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :source, "Fonte", class: "label" %>
    <%= form.select :source, JobPosting.enum_options(:source), { include_blank: "Todas", selected: @filter[:source] }, class: "input", data: submit %>
  </div>
  <div>
    <%= form.label :q, "Buscar", class: "label" %>
    <%= form.search_field :q, value: @filter[:q], placeholder: "título, empresa…", class: "input" %>
  </div>
  <div class="flex items-end gap-3 pb-2">
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :salary, { checked: @filter[:salary] == "1", class: "size-4 accent-accent", data: submit }, "1", nil %>
      Com salário
    </label>
    <% if @filter.active? %>
      <%= link_to "Limpar filtros", job_postings_path, class: "text-sm" %>
    <% end %>
  </div>
<% end %>

<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
  <p class="muted text-sm"><%= pluralize(@total, "vaga", plural: "vagas") %> · <%= JobPostingFilter::SORTS[@filter[:sort]].downcase %> primeiro</p>
  <% if @filter[:triage] == "new" && @total.positive? %>
    <% label = @filter.active? ? "Descartar as #{@total} desta lista" : "Descartar todas (#{@total})" %>
    <%= button_to label, dismiss_all_job_postings_path, params: @filter.to_params.except("triage", "sort"), class: "btn btn-sm",
                  form: { data: { turbo_confirm: "Descartar #{@total == 1 ? "1 vaga" : "#{@total} vagas"}#{" desta lista" if @filter.active?}? Elas saem da triagem, mas continuam em Triagem → Descartada." } } %>
  <% end %>
</div>

<div class="card divide-y divide-line">
  <%= render partial: "job_postings/job_posting", collection: @job_postings %>
  <% if @job_postings.empty? %>
    <p class="muted p-8 text-center text-sm">Nenhuma vaga com esses filtros.</p>
  <% end %>
</div>

<% if @total > JobPostingsController::PER_PAGE %>
  <nav class="mt-4 flex items-center justify-between text-sm" aria-label="Páginas">
    <% if @page.positive? %>
      <%= link_to "← Anteriores", job_postings_path(@filter.to_params.merge("page" => @page - 1)), class: "btn btn-sm" %>
    <% else %><span></span><% end %>
    <span class="muted">Página <%= @page + 1 %> de <%= (@total.to_f / JobPostingsController::PER_PAGE).ceil %></span>
    <% if (@page + 1) * JobPostingsController::PER_PAGE < @total %>
      <%= link_to "Próximas →", job_postings_path(@filter.to_params.merge("page" => @page + 1)), class: "btn btn-sm" %>
    <% else %><span></span><% end %>
  </nav>
<% end %>

<details class="card mt-8 p-4">
  <summary class="cursor-pointer font-semibold">Fontes do agregador</summary>
  <p class="muted mt-2 text-sm">Roda sozinho a cada 3 horas. Remotive é consultado no máximo 4 vezes por dia, como pedem os termos da API; as vagas levam o link e o crédito de cada fonte.</p>
  <table class="table mt-3">
    <thead><tr><th>Fonte</th><th>Última busca</th><th>Status</th><th>Encontradas</th><th>Novas</th><th>Aviso</th></tr></thead>
    <tbody>
      <% @source_runs.each do |run| %>
        <tr>
          <td><%= JobPosting.human_enum(:source, run.source) %></td>
          <td class="whitespace-nowrap"><%= l(run.created_at, format: "%d/%m %H:%M") %></td>
          <td><span class="chip <%= run.status_failed? ? "chip-hot" : "" %>"><%= run.human_enum(:status) %></span></td>
          <td><%= run.fetched_count %></td>
          <td><%= run.created_count %></td>
          <td class="muted max-w-xs truncate text-xs" title="<%= run.error_message %>"><%= run.error_message %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @source_runs.empty? %><p class="muted mt-2 text-sm">Nenhuma busca rodou ainda.</p><% end %>
</details>
