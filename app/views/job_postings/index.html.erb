<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<div data-controller="refresh-on-return" hidden></div>

<%= page_header eyebrow: "triagem", title: "Vagas",
                intro: "Vagas do agregador, dos alertas do LinkedIn e da extensão. Salve as que valem a pena e descarte o resto." do %>
  <%= button_to "Buscar agora", fetch_job_postings_path, class: "btn" %>
  <%= link_to "Adicionar vaga", new_job_posting_path, class: "btn btn-primary" %>
<% end %>

<% more = %w[period keyword source salary].any? { @filter[it].present? } %>
<%= form_with url: job_postings_path, method: :get, class: "flex flex-wrap items-end gap-x-5 gap-y-4 pb-8", data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
  <% submit = { action: "auto-submit#submit" } %>
  <fieldset>
    <legend class="label">Triagem</legend>
    <div class="seg">
      <% { "new" => "Novas", "saved" => "Salvas", "dismissed" => "Descartadas", "auto" => "Auto-descartadas", "all" => "Todas" }.each do |value, label| %>
        <label class="seg-opt">
          <%= form.radio_button :triage, value, checked: @filter[:triage] == value, data: submit %>
          <%= label %> <span id="triage_count_<%= value %>"><%= @triage_counts.fetch(value, 0) %></span>
        </label>
      <% end %>
    </div>
  </fieldset>
  <fieldset>
    <legend class="label">Ordenar por</legend>
    <div class="seg">
      <% { "score" => "Nota", "recent" => "Mais novas" }.each do |value, label| %>
        <label class="seg-opt"><%= form.radio_button :sort, value, checked: @filter[:sort] == value, data: submit %><%= label %></label>
      <% end %>
    </div>
  </fieldset>
  <div class="w-[130px]">
    <%= form.label :min_score, "Nota mínima", class: "label" %>
    <%= form.select :min_score, JobPostingFilter::MIN_SCORES.map { [ "#{it}+", it ] }, { include_blank: "Qualquer", selected: @filter[:min_score] }, class: "input", data: submit %>
  </div>
  <div class="w-[170px]">
    <%= form.label :remote_scope, "Região", class: "label" %>
    <%= form.select :remote_scope, [ [ "Abertas ao Brasil", JobPostingFilter::OPEN_TO_BRAZIL ] ] + JobPosting.enum_options(:remote_scope), { include_blank: "Todas", selected: @filter[:remote_scope] }, class: "input", data: submit %>
  </div>
  <div class="w-[140px]">
    <%= form.label :seniority, "Senioridade", class: "label" %>
    <%= form.select :seniority, JobPosting.enum_options(:seniority), { include_blank: "Todas", selected: @filter[:seniority] }, class: "input", data: submit %>
  </div>
  <div class="max-w-[320px] flex-[1_1_200px]">
    <%= form.label :q, "Buscar", class: "label" %>
    <%= form.search_field :q, value: @filter[:q], placeholder: "título, empresa…", class: "input" %>
  </div>
  <details class="basis-full" <%= "open" if more %>>
    <summary class="inline-block text-[13.5px] text-accent hover:text-accent-hover">Mais filtros</summary>
    <div class="mt-3 flex flex-wrap items-end gap-x-5 gap-y-4">
      <div class="w-[170px]">
        <%= form.label :period, "Publicadas", class: "label" %>
        <%= form.select :period, JobPostingFilter::PERIODS.map { |value, (_, label)| [ label, value ] }, { include_blank: "Qualquer data", selected: @filter[:period] }, class: "input", data: submit %>
      </div>
      <div class="w-[170px]">
        <%= form.label :keyword, "Tecnologia", class: "label" %>
        <%= form.select :keyword, JobPostingFilter.keywords, { include_blank: "Qualquer", selected: @filter[:keyword] }, class: "input", data: submit %>
      </div>
      <div class="w-[190px]">
        <%= form.label :source, "Fonte", class: "label" %>
        <%= form.select :source, JobPosting.enum_options(:source), { include_blank: "Todas", selected: @filter[:source] }, class: "input", data: submit %>
      </div>
      <label class="flex min-h-9 items-center gap-2 text-sm">
        <%= form.check_box :salary, { checked: @filter[:salary] == "1", class: "check", data: submit }, "1", nil %>
        Com salário
      </label>
    </div>
  </details>
  <noscript><%= form.submit "Filtrar", class: "btn" %></noscript>
<% end %>

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-3 text-[13.5px] text-ink/70">
  <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span><%= pluralize(@total, "vaga", plural: "vagas") %> · <%= JobPostingFilter::SORTS[@filter[:sort]].downcase %> primeiro</span>
    <% if @filter.active? %><%= link_to "Limpar filtros", job_postings_path %><% end %>
    <% if @filter[:triage] == "new" && @total.positive? %>
      <% label = @filter.active? ? "Descartar as #{@total} desta lista" : "Descartar todas (#{@total})" %>
      <%= button_to label, dismiss_all_job_postings_path, params: @filter.to_params.except("triage", "sort"), class: "btn btn-ghost btn-sm",
                    form: { class: "inline", data: { turbo_confirm: "Descartar #{@total == 1 ? "1 vaga" : "#{@total} vagas"}#{" desta lista" if @filter.active?}? Elas saem da triagem, mas continuam em Triagem → Descartadas." } } %>
    <% end %>
  </p>
  <span class="hidden lg:inline">↑ ↓ navegar · S salvar · A salvar em aplicadas · D descartar</span>
</div>

<div class="grid items-start gap-x-[clamp(36px,5vw,72px)] gap-y-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
     data-controller="triage" data-triage-tab-value="<%= @filter[:triage] %>" data-action="keydown@window->triage#keydown">
  <div class="min-w-0">
    <div role="listbox" aria-label="Vagas" class="flex flex-col gap-0.5">
      <%= render partial: "job_postings/job_posting", collection: @job_postings, locals: { selected: @selected } %>
    </div>
    <% if @job_postings.empty? %>
      <p class="py-10 text-[15.5px] text-ink/70">Nenhuma vaga com esses filtros.</p>
    <% end %>

    <% if @total > JobPostingsController::PER_PAGE %>
      <nav class="mt-6 flex items-center justify-between text-sm" aria-label="Páginas">
        <% if @page.positive? %>
          <%= link_to "← Anteriores", job_postings_path(@filter.to_params.merge("page" => @page - 1)), class: "btn btn-sm" %>
        <% else %><span></span><% end %>
        <span class="font-mono text-xs text-muted">Página <%= @page + 1 %> de <%= (@total.to_f / JobPostingsController::PER_PAGE).ceil %></span>
        <% if (@page + 1) * JobPostingsController::PER_PAGE < @total %>
          <%= link_to "Próximas →", job_postings_path(@filter.to_params.merge("page" => @page + 1)), class: "btn btn-sm" %>
        <% else %><span></span><% end %>
      </nav>
    <% end %>
  </div>

  <div class="hidden min-w-0 lg:sticky lg:top-6 lg:block lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-2">
    <% if @selected %>
      <%= render "job_postings/detail", job_posting: @selected, ai_artifacts: @ai_artifacts %>
    <% else %>
      <%= turbo_frame_tag "posting_detail", data: { triage_target: "frame" } %>
    <% end %>
  </div>
</div>

<details class="mt-16 border-t border-line pt-6">
  <summary class="font-display text-lg font-semibold">Fontes do agregador</summary>
  <p class="mt-2 max-w-[72ch] text-[13.5px] text-muted">Roda sozinho a cada 3 horas. Remotive é consultado no máximo 4 vezes por dia, como pedem os termos da API; as vagas levam o link e o crédito de cada fonte.</p>
  <div class="mt-3 overflow-x-auto">
    <table class="table min-w-[680px]">
      <thead><tr><th>Fonte</th><th>Última busca</th><th>Situação</th><th class="text-right">Encontradas</th><th class="text-right">Novas</th><th>Aviso</th></tr></thead>
      <tbody>
        <% @source_runs.each do |run| %>
          <tr>
            <td class="font-semibold"><%= JobPosting.human_enum(:source, run.source) %></td>
            <td class="font-mono text-[12.5px] whitespace-nowrap"><%= short_time(run.created_at) %></td>
            <td><span class="chip <%= "chip-warn" if run.status_failed? %>"><%= run.human_enum(:status) %></span></td>
            <td class="text-right font-mono text-[12.5px]"><%= run.fetched_count %></td>
            <td class="text-right font-mono text-[12.5px]"><%= run.created_count %></td>
            <td class="max-w-xs truncate text-[12.5px] text-muted" title="<%= run.error_message %>"><%= run.error_message %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @source_runs.empty? %><p class="mt-2 text-sm text-muted">Nenhuma busca rodou ainda.</p><% end %>
</details>
