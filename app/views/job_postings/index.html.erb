<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<div data-controller="refresh-on-return" hidden></div>

<%= page_header eyebrow: t(".eyebrow"), title: t(".title"), intro: t(".intro") do %>
  <% if @fetch_available_at %>
    <button type="button" class="btn" disabled title="<%= t(".fetch_wait_title") %>"><%= t(".fetch_wait", time: l(@fetch_available_at, format: :hour)) %></button>
  <% else %>
    <%= button_to t(".fetch"), fetch_job_postings_path, class: "btn" %>
  <% end %>
  <%= link_to t(".add"), new_job_posting_path, class: "btn btn-primary" %>
<% end %>

<% more = %w[period keyword source salary].any? { @filter[it].present? } %>
<%= form_with url: job_postings_path, method: :get, class: "panel mb-7 flex flex-col gap-4", data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
  <% submit = { action: "auto-submit#submit" } %>
  <%# Two rows (triage and order; then the selects and the search), each field growing to fill its row. %>
  <div class="flex flex-wrap items-end gap-x-5 gap-y-4">
    <fieldset class="min-w-0 flex-[3_1_auto]">
      <legend class="label"><%= t(".filter.triage") %></legend>
      <div class="seg flex w-full">
        <% %w[new saved dismissed auto all].each do |value| %>
          <label class="seg-opt flex-auto justify-center">
            <%= form.radio_button :triage, value, checked: @filter[:triage] == value, data: submit %>
            <%= t(".filter.triages.#{value}") %> <span id="triage_count_<%= value %>"><%= @triage_counts.fetch(value, 0) %></span>
          </label>
        <% end %>
      </div>
    </fieldset>
    <fieldset class="min-w-0 flex-[1_1_auto]">
      <legend class="label"><%= t(".filter.sort") %></legend>
      <div class="seg flex w-full">
        <% %w[score recent].each do |value| %>
          <label class="seg-opt flex-auto justify-center"><%= form.radio_button :sort, value, checked: @filter[:sort] == value, data: submit %><%= t(".filter.sorts.#{value}") %></label>
        <% end %>
      </div>
    </fieldset>
  </div>
  <div class="flex flex-wrap items-end gap-x-5 gap-y-4 max-sm:grid max-sm:grid-cols-2 max-sm:gap-x-3 max-sm:gap-y-3">
    <div class="flex-[1_1_140px]">
      <%= form.label :min_score, t(".filter.min_score"), class: "label" %>
      <%= form.select :min_score, JobPostingFilter::MIN_SCORES.map { [ "#{it}+", it ] }, { include_blank: t(".filter.any"), selected: @filter[:min_score] }, class: "input", data: submit %>
    </div>
    <div class="flex-[1_1_170px]">
      <%= form.label :remote_scope, t(".filter.region"), class: "label" %>
      <%= form.select :remote_scope, [ [ t(".filter.open_to_brazil"), JobPostingFilter::OPEN_TO_BRAZIL ] ] + JobPosting.enum_options(:remote_scope), { include_blank: t(".filter.all"), selected: @filter[:remote_scope] }, class: "input", data: submit %>
    </div>
    <div class="flex-[1_1_140px]">
      <%= form.label :seniority, t(".filter.seniority"), class: "label" %>
      <%= form.select :seniority, JobPosting.enum_options(:seniority), { include_blank: t(".filter.all"), selected: @filter[:seniority] }, class: "input", data: submit %>
    </div>
    <div class="flex-[2_1_220px] max-sm:order-first max-sm:col-span-2">
      <%= form.label :q, t(".filter.search"), class: "label" %>
      <%= form.search_field :q, value: @filter[:q], placeholder: t(".filter.search_placeholder"), class: "input" %>
    </div>
  </div>
  <details <%= "open" if more %>>
    <summary class="inline-block text-[13.5px] text-accent hover:text-accent-hover"><%= t(".filter.more") %></summary>
    <div class="mt-3 flex flex-wrap items-end gap-x-5 gap-y-4 max-sm:grid max-sm:grid-cols-2 max-sm:gap-x-3 max-sm:gap-y-3">
      <div class="flex-[1_1_170px]">
        <%= form.label :period, t(".filter.posted"), class: "label" %>
        <%= form.select :period, JobPostingFilter::PERIODS.keys.map { [ t(".filter.periods.p#{it}"), it ] }, { include_blank: t(".filter.any_date"), selected: @filter[:period] }, class: "input", data: submit %>
      </div>
      <div class="flex-[1_1_170px]">
        <%= form.label :keyword, t(".filter.keyword"), class: "label" %>
        <%= form.select :keyword, JobPostingFilter.keywords, { include_blank: t(".filter.any"), selected: @filter[:keyword] }, class: "input", data: submit %>
      </div>
      <div class="flex-[1_1_190px]">
        <%= form.label :source, t(".filter.source"), class: "label" %>
        <%= form.select :source, JobPosting.enum_options(:source), { include_blank: t(".filter.all"), selected: @filter[:source] }, class: "input", data: submit %>
      </div>
      <label class="flex min-h-9 items-center gap-2 text-sm">
        <%= form.check_box :salary, { checked: @filter[:salary] == "1", class: "check", data: submit }, "1", nil %>
        <%= t(".filter.with_salary") %>
      </label>
    </div>
  </details>
  <noscript><%= form.submit t(".filter.submit"), class: "btn" %></noscript>
<% end %>

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pb-3 text-[13.5px] text-ink/70">
  <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span><%= t(".summary", count: @total, sort: t(".filter.order.#{@filter[:sort]}")) %></span>
    <% if @filter.active? %><%= link_to t(".clear"), job_postings_path %><% end %>
    <% if @filter[:triage] == "new" && @total.positive? %>
      <% label = @filter.active? ? t(".dismiss_list", count: @total) : t(".dismiss_all", count: @total) %>
      <%= button_to label, dismiss_all_job_postings_path, params: @filter.to_params.except("triage", "sort"), class: "btn btn-ghost btn-sm",
                    form: { class: "inline", data: { turbo_confirm: t(@filter.active? ? ".dismiss_list_confirm" : ".dismiss_all_confirm", count: @total) } } %>
    <% end %>
  </p>
  <span class="hidden lg:inline"><%= t(".shortcuts") %></span>
</div>

<div class="grid items-start gap-x-[clamp(36px,5vw,72px)] gap-y-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]"
     data-controller="triage" data-triage-tab-value="<%= @filter[:triage] %>" data-action="keydown@window->triage#keydown">
  <div class="min-w-0">
    <div role="listbox" aria-label="<%= t(".title") %>" class="flex flex-col gap-0.5">
      <%= render partial: "job_postings/job_posting", collection: @job_postings, locals: { selected: @selected } %>
    </div>
    <% if @job_postings.empty? %>
      <p class="py-10 text-[15.5px] text-ink/70"><%= t(".empty") %></p>
    <% end %>

    <% if @total > JobPostingsController::PER_PAGE %>
      <nav class="mt-6 flex items-center justify-between text-sm" aria-label="<%= t(".pages") %>">
        <% if @page.positive? %>
          <%= link_to t(".previous"), job_postings_path(@filter.to_params.merge("page" => @page - 1)), class: "btn btn-sm" %>
        <% else %><span></span><% end %>
        <span class="font-mono text-xs text-muted"><%= t(".page", page: @page + 1, total: (@total.to_f / JobPostingsController::PER_PAGE).ceil) %></span>
        <% if (@page + 1) * JobPostingsController::PER_PAGE < @total %>
          <%= link_to t(".next"), job_postings_path(@filter.to_params.merge("page" => @page + 1)), class: "btn btn-sm" %>
        <% else %><span></span><% end %>
      </nav>
    <% end %>
  </div>

  <div class="hidden min-w-0 lg:sticky lg:top-6 lg:block lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto lg:overscroll-contain lg:pr-2">
    <% if @selected %>
      <%= render "job_postings/detail", job_posting: @selected, ai_artifacts: @ai_artifacts %>
    <% else %>
      <%= turbo_frame_tag "posting_detail", data: { triage_target: "frame" } %>
    <% end %>
  </div>
</div>

<details class="mt-16 border-t border-line pt-6">
  <summary class="font-display text-lg font-semibold"><%= t(".sources.title") %></summary>
  <p class="mt-2 max-w-[72ch] text-[13.5px] text-muted"><%= t(".sources.note") %></p>
  <div class="mt-3 table-scroll">
    <table class="table min-w-[680px]">
      <thead><tr><th><%= t(".sources.source") %></th><th><%= t(".sources.last_run") %></th><th><%= t(".sources.status") %></th><th class="text-right"><%= t(".sources.found") %></th><th class="text-right"><%= t(".sources.new") %></th><th><%= t(".sources.warning") %></th></tr></thead>
      <tbody>
        <% @source_runs.each do |run| %>
          <tr>
            <td class="font-semibold"><%= JobPosting.human_enum(:source, run.source) %></td>
            <td class="font-mono text-[12.5px] whitespace-nowrap"><%= short_time(run.created_at) %></td>
            <td><span class="chip <%= "chip-warn" if run.status_failed? %>"><%= run.human_enum(:status) %></span></td>
            <td class="text-right font-mono text-[12.5px]"><%= run.fetched_count %></td>
            <td class="text-right font-mono text-[12.5px]"><%= run.created_count %></td>
            <td class="max-w-xs truncate text-[12.5px] text-muted" title="<%= run.error_message %>"><%= run.error_message %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @source_runs.empty? %><p class="mt-2 text-sm text-muted"><%= t(".sources.none") %></p><% end %>
</details>
