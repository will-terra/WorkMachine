<%# An item of the Vagas list. Locals: selected (the posting shown in the detail). %>
<% known = contacts_at(job_posting.company).size %>
<% tags = [
     (tag.span(safe_join([ icon(:user, size: 12), t("contacts.at_company.chip", count: known) ]), class: "chip chip-hot", title: t("contacts.at_company.title", count: known, company: job_posting.display_company)) if known.positive?),
     (tag.span(job_posting.human_enum(:triage), class: "chip chip-outline") unless job_posting.triage_new?),
     (tag.span(t("job_postings.posting.auto_dismissed", reason: JobScorer.human_term(job_posting.auto_dismissed_reason)), class: "chip chip-warn", title: t("job_postings.posting.auto_dismissed_title")) if job_posting.auto_dismissed_reason),
     (tag.span(t("job_postings.posting.partial"), class: "chip chip-warn", title: t("job_postings.posting.partial_title")) if job_posting.partial_score?),
     posting_terms(job_posting, limit: 3).presence
   ].compact %>
<%= link_to job_posting_path(job_posting), id: dom_id(job_posting), role: "option",
      aria: { selected: local_assigns[:selected] == job_posting },
      class: "-mx-3.5 grid grid-cols-[48px_minmax(0,1fr)] items-baseline gap-3.5 rounded-md px-3.5 pt-3.5 pb-[15px] text-ink no-underline hover:bg-ink/4 hover:text-ink lg:aria-selected:bg-surface",
      data: { triage_target: "item", action: "triage#pick", id: job_posting.id, triage: job_posting.triage, auto: job_posting.auto_dismissed_reason.present?, turbo_frame: "_top" } do %>
  <span class="font-display text-[26px] leading-none font-semibold tabular-nums <%= score_class(job_posting.score) %>" title="<%= t("job_postings.posting.score_title") %>"><%= job_posting.score %></span>
  <span class="block min-w-0">
    <span class="block text-base leading-[1.3] font-semibold"><%= job_posting.title %></span>
    <span class="mt-[3px] block text-[13.5px] leading-[1.45] text-ink/70"><%= posting_meta(job_posting) %></span>
    <% if tags.any? %><span class="mt-2 flex flex-wrap gap-1"><%= safe_join(tags) %></span><% end %>
  </span>
<% end %>
