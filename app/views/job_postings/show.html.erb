<%= page_header eyebrow: "#{@job_posting.human_enum(:source)} · #{@job_posting.human_enum(:triage)}", title: @job_posting.title do %>
  <%= external_link "Abrir vaga", @job_posting.url, class: "btn btn-sm" %>
  <%= link_to "Mensagem", message_templates_path(job_posting_id: @job_posting.id), class: "btn btn-sm" %>
  <% if @job_posting.triage_new? %>
    <%= button_to "Descartar", dismiss_job_posting_path(@job_posting), class: "btn btn-sm" %>
    <%= button_to "Salvar em Candidaturas", save_job_posting_path(@job_posting), class: "btn btn-primary btn-sm" %>
  <% end %>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
  <section class="card min-w-0 p-5" aria-label="Descrição">
    <% if @job_posting.description.present? %>
      <div class="max-w-prose text-[15px] leading-relaxed"><%= simple_format(@job_posting.description) %></div>
    <% else %>
      <p class="muted text-sm">Sem descrição. Abra a vaga e salve de novo pela extensão para trazer o texto completo.</p>
    <% end %>
  </section>

  <aside class="grid content-start gap-4">
    <div class="card p-4">
      <p class="label">Nota</p>
      <p class="font-mono text-4xl font-semibold <%= score_class(@job_posting.score) %>"><%= @job_posting.score %><span class="text-base text-muted"> / 100</span></p>
      <ul class="mt-3 grid gap-1 text-sm">
        <% @job_posting.matched_keywords.each do |match| %>
          <li class="flex justify-between gap-3"><span><%= match["term"] %></span><span class="font-mono <%= match["points"].negative? ? "text-accent" : "text-ok" %>"><%= format("%+d", match["points"]) %></span></li>
        <% end %>
      </ul>
    </div>
    <dl class="card grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 p-4 text-sm">
      <dt class="muted">Empresa</dt><dd><%= @job_posting.display_company %></dd>
      <dt class="muted">Local</dt><dd><%= @job_posting.location_text.presence || "—" %></dd>
      <dt class="muted">Região</dt><dd><%= @job_posting.human_enum(:remote_scope) %></dd>
      <dt class="muted">Senioridade</dt><dd><%= @job_posting.human_enum(:seniority) %></dd>
      <dt class="muted">Salário</dt><dd><%= @job_posting.salary_text.presence || "—" %></dd>
      <dt class="muted">Publicada</dt><dd><%= @job_posting.posted_at ? l(@job_posting.posted_at, format: "%d/%m/%Y") : "—" %></dd>
      <dt class="muted">Fonte</dt><dd>via <%= external_link @job_posting.human_enum(:source), @job_posting.url %></dd>
      <% if @job_posting.job_application %>
        <dt class="muted">Candidatura</dt><dd><%= link_to @job_posting.job_application.human_enum(:status), edit_job_application_path(@job_posting.job_application) %></dd>
      <% end %>
    </dl>
  </aside>
</div>

<%= render "job_postings/ai", job_posting: @job_posting, ai_artifacts: @ai_artifacts %>
