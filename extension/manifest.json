{
  "manifest_version": 3,
  "name": "WorkMachine",
  "version": "1.2.0",
  "description": "Salva vagas e recrutadores no WorkMachine (localhost:3000) e mostra no ícone a nota das vagas do LinkedIn que já estão lá.",
  "homepage_url": "https://github.com/will-terra/WorkMachine",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*", "https://*.linkedin.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Salvar no WorkMachine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
